---
/**
 * Landing del Gauntlet Challenge (agosto 2026).
 *
 * Es una PÁGINA DE ANUNCIO: no guarda un solo dato. La inscripción vive en un
 * Google Form externo, y la entrega y la votación se explican pero no se
 * construyen — eso necesita el backend cloud-api, al que esta web no tiene
 * acceso. De ahí que la página no lleve ni una isla ni un endpoint. El único
 * JavaScript propio es el botón que copia el prompt al portapapeles: no manda
 * nada a ninguna parte y no necesita hidratar nada.
 *
 * Regla que sostiene ese alcance: cada pieza que se menciona pero no existe
 * dice dónde va a ocurrir de verdad. En la práctica, el Discord de NaN — que
 * no tiene invitación pública, así que el destino es /community, la página que
 * explica cómo entrar. Nada de botones muertos.
 *
 * La página NO está prerenderizada, así que la fase se recalcula en cada
 * petición con el reloj del Worker (UTC): cerca de medianoche en Canarias o
 * LATAM puede ir un día adelantado. Es inofensivo a propósito — la fase solo
 * cambia texto y enlaces, nunca deja a nadie fuera (ver lib/gauntlet.ts).
 */
import NanPage from '../layouts/NanPage.astro';
import StructuredData from '../components/nan/StructuredData.astro';
import eventos from '../data/eventos.json';
import { getLang, useT, withLang } from '../lib/i18n';
import { spanLabel } from '../lib/agenda';
import { calendarMonth, gauntletState, statusText, type GauntletDates } from '../lib/gauntlet';
import { GAUNTLET_PROMPT as P, promptText } from '../data/gauntletPrompt';
import { GAUNTLET_SHOWCASE } from '../data/gauntletShowcase';

const lang = getLang(Astro.url);
const tt = useT(lang).gauntlet;

const site = Astro.site ?? new URL('https://nan.builders');
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', site).href;

const dates = eventos.gauntlet as GauntletDates;
const state = gauntletState(dates, new Date());
const status = statusText(state, tt.status);

// El chip de fechas sale del mismo formateador que la fila de la agenda de
// /events, para que las dos digan exactamente lo mismo ("Aug 8 – 28").
const range = spanLabel({ date: dates.start, until: dates.close, type: 'event', title: '' }, lang);

// La rejilla del calendario del mes de construcción, marcada día a día.
const month = calendarMonth(dates);
// Huecos para cerrar la última semana: sin ellos la rejilla acaba en un
// escalón y el borde inferior deja de ser una línea.
const trail = (7 - ((month.lead + month.cells.length) % 7)) % 7;

const communityHref = withLang('/community', lang);
const projectsHref = withLang('/projects', lang);

// Los ejemplos de la 01. El primero va destacado a ancho completo y el resto en
// una fila; el título y la descripción viven en i18n y se emparejan por id, así
// que el enlace y la imagen no se duplican en los dos idiomas.
const [leadShot, ...restShots] = GAUNTLET_SHOWCASE;
type ShotCopy = { title: string; desc: string };
const shotCopy = (id: string): ShotCopy => (tt.showcase.items as Record<string, ShotCopy>)[id];

// El botón de inscripción solo existe si hay formulario al otro lado. Mientras
// `form.url` esté vacío, la página dice cuándo abre en vez de enseñar un botón
// que no lleva a ningún sitio.
const formUrl = tt.form.url;
const signupOpen = state.phase === 'pre' || state.phase === 'live';

// CTA principal por fase. En `pre` y `live` empuja al formulario; después, al
// sitio donde la cosa ocurre de verdad.
const cta =
  signupOpen && formUrl
    ? { href: formUrl, label: tt.form.cta, external: true }
    : state.phase === 'voting'
      ? { href: communityHref, label: tt.ctaVote, external: false }
      : state.phase === 'closed'
        ? { href: projectsHref, label: tt.ctaClosed, external: false }
        : { href: communityHref, label: tt.ctaSecondary, external: false };
---

<NanPage title={tt.metaTitle} description={tt.metaDesc}>
  <StructuredData slot="head" lang={lang} page="gauntlet" canonical={canonical} origin={site.origin} />

  <!-- 00 HERO -->
  <header class="ghero">
    <div class="container" data-reveal>
      <p class="eyebrow">{tt.heroEyebrow}</p>
      <h1 class="ghero__title">{tt.heroTitle1}<br /><span class="hl">{tt.heroTitle2}</span></h1>
      <p class="ghero__sub">{tt.heroSub}</p>

      <div class="ghero__chips">
        <span class="chip chip--v mono">{status}</span>
        <span class="chip mono">{range} · 2026</span>
      </div>

      <div class="ghero__cta">
        <a
          class="btn btn-primary"
          href={cta.href}
          {...cta.external ? { target: '_blank', rel: 'noopener' } : {}}
        >
          {cta.label} →
        </a>
        <a class="btn btn-ghost" href="#join">{tt.join.label} →</a>
      </div>

      {signupOpen && formUrl && <p class="ghero__note mono">{tt.form.note}</p>}
    </div>
  </header>

  <!-- 01 LO QUE YA ESTÁ SALIENDO -->
  {/* Enseñar antes de explicar: quien llega no sabe qué es un Gauntlet Loop,
      pero sí sabe reconocer un juego que funciona. Son cinco proyectos de otra
      gente, así que cada tarjeta enlaza a su publicación y lleva el handle a la
      vista. Las miniaturas se sirven desde /public a propósito: abrir la página
      no manda una sola petición a X hasta que alguien hace clic. */}
  <section class="gsec">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">01</span><span class="sechead__label">{tt.showcase.label}</span>
      </div>
      <h2 class="gsec__title caret-type" data-reveal>{tt.showcase.title}</h2>
      <p class="gsec__sub" data-reveal>{tt.showcase.lead}</p>

      <a
        class="shot shot--lead"
        href={leadShot.href}
        target="_blank"
        rel="noopener"
        data-reveal
      >
        <span class="shot__screen">
          <img
            class="shot__img"
            src={leadShot.img}
            alt={shotCopy(leadShot.id).title}
            width="640"
            height="360"
            loading="lazy"
          />
          <span class="shot__scan" aria-hidden="true"></span>
          <span class="shot__play" aria-hidden="true"></span>
          {/* Solo lo lleva el que nombra el bucle en su publicación. Los otros
              cuatro no lo dicen, y ponerles la etiqueta sería firmar por ellos. */}
          {leadShot.credits && <span class="shot__badge mono">{tt.showcase.credits}</span>}
        </span>
        <span class="shot__body">
          <span class="shot__title">{shotCopy(leadShot.id).title}</span>
          <span class="shot__desc">{shotCopy(leadShot.id).desc}</span>
          <span class="shot__meta mono">@{leadShot.author} · {leadShot.date} ↗</span>
        </span>
      </a>

      <div class="shots" data-reveal-stagger>
        {restShots.map((s) => (
          <a class="shot" href={s.href} target="_blank" rel="noopener">
            <span class="shot__screen">
              <img
                class="shot__img"
                src={s.img}
                alt={shotCopy(s.id).title}
                width="640"
                height="360"
                loading="lazy"
              />
              <span class="shot__scan" aria-hidden="true"></span>
              <span class="shot__play" aria-hidden="true"></span>
            </span>
            <span class="shot__body">
              <span class="shot__title">{shotCopy(s.id).title}</span>
              <span class="shot__desc">{shotCopy(s.id).desc}</span>
              <span class="shot__meta mono">@{s.author} · {s.date} ↗</span>
            </span>
          </a>
        ))}
      </div>

      <p class="gfoot">{tt.showcase.foot}</p>
    </div>
  </section>

  <!-- 02 DE DÓNDE SALE ESTO -->
  {/* Lo único escrito para quien no sabe nada: de dónde viene el nombre y las
      tres preguntas que hace cualquiera antes de decidir si esto va con él.
      Todo lo que viene detrás da por sabido lo que se cuenta aquí. */}
  <section class="gsec">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">02</span><span class="sechead__label">{tt.context.label}</span>
      </div>
      <h2 class="gsec__title caret-type" data-reveal>{tt.context.title}</h2>
      <p class="gsec__sub" data-reveal>{tt.context.lead}</p>

      <div class="qa" data-reveal-stagger>
        {tt.context.cards.map((c) => (
          <div class="qa__card">
            <h3 class="qa__q">{c.q}</h3>
            <p class="qa__a">{c.a}</p>
            {/* Solo la tarjeta de la comunidad tiene a dónde ir. Las otras dos
                se responden aquí mismo y no mandan a nadie a ningún sitio. */}
            {'link' in c && <a class="qa__link mono" href={communityHref}>{c.link} →</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 EL PROMPT -->
  <section class="gsec">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">03</span><span class="sechead__label">{tt.prompt.label}</span>
      </div>
      <h2 class="gsec__title caret-type" data-reveal>{tt.prompt.title}</h2>
      <p class="gsec__sub" data-reveal>{tt.prompt.lead}</p>

      {/* El prompt anotado a mano, como la captura de la que salió: el texto en
          la columna del medio y las lecturas de cada trozo subrayado en los
          márgenes. Cada párrafo es una fila propia para que su nota caiga a su
          altura sin posicionar nada en absoluto; en móvil las notas se apilan
          debajo del párrafo que anotan, que es donde tienen sentido. */}
      <div class="frame" data-reveal>
        <p class="frame__title mono">{tt.prompt.frame}</p>

        <div class="pr">
          <div class="pr__row">
            <div class="pr__side" />
            <p class="pr__p">{P[0].map((s) => (s.ink ? <mark class:list={["ink", `is-${s.ink}`]}>{s.t}</mark> : s.t))}</p>
            <div class="pr__side">
              <p class="note is-ref"><span class="note__arrow" aria-hidden="true">↖</span>{tt.prompt.notes.ref}</p>
            </div>
          </div>

          <div class="pr__row">
            <div class="pr__side">
              <p class="note is-loop">{tt.prompt.notes.loop}<span class="note__arrow" aria-hidden="true">↘</span></p>
              <p class="note is-critic">{tt.prompt.notes.critic}<span class="note__arrow" aria-hidden="true">↘</span></p>
            </div>
            <p class="pr__p">{P[1].map((s) => (s.ink ? <mark class:list={["ink", `is-${s.ink}`]}>{s.t}</mark> : s.t))}</p>
            <div class="pr__side">
              <p class="note is-fanout"><span class="note__arrow" aria-hidden="true">↖</span>{tt.prompt.notes.fanout}</p>
              <p class="note is-harsh"><span class="note__arrow" aria-hidden="true">↙</span>{tt.prompt.notes.harsh}</p>
            </div>
          </div>

          <div class="pr__row">
            <div class="pr__side" />
            <p class="pr__p">{P[2].map((s) => (s.ink ? <mark class:list={["ink", `is-${s.ink}`]}>{s.t}</mark> : s.t))}</p>
            <div class="pr__side">
              <p class="note is-ultra"><span class="note__arrow" aria-hidden="true">↙</span>{tt.prompt.notes.ultra}</p>
            </div>
          </div>
        </div>

        <div class="frame__foot">
          {/* El texto que se copia sale de la misma lista que se pinta arriba,
              así que no pueden divergir. El botón no habla con nadie: escribe
              en el portapapeles y ya. */}
          <button
            type="button"
            class="btn btn-primary copy"
            data-copy-prompt
            data-prompt={promptText()}
            data-label={tt.prompt.copy}
            data-done={tt.prompt.copied}
            data-fail={tt.prompt.copyFail}
          >
            <span class="copy__label">{tt.prompt.copy}</span>
          </button>
          <p class="copy__note mono">{tt.prompt.foot}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 LA IDEA -->
  <section class="gsec">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">04</span><span class="sechead__label">{tt.idea.label}</span>
      </div>
      <h2 class="gsec__title caret-type" data-reveal>{tt.idea.title}</h2>
      <p class="gsec__sub" data-reveal>{tt.idea.sub}</p>

      <ol class="loop" data-reveal-stagger>
        {tt.idea.steps.map((s) => (
          <li class="loop__step">
            <span class="loop__n mono">{s.n}</span>
            <h3 class="loop__name">{s.name}</h3>
            <p class="loop__body">{s.body}</p>
          </li>
        ))}
      </ol>

      <p class="quote" data-reveal>{tt.idea.quote}</p>
      <p class="gnote" data-reveal>{tt.idea.note}</p>
    </div>
  </section>

  <!-- 05 CÓMO SE DISEÑA -->
  <section class="gsec">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">05</span><span class="sechead__label">{tt.design.label}</span>
      </div>
      <h2 class="gsec__title caret-type" data-reveal>{tt.design.title}</h2>
      <p class="gsec__sub" data-reveal>{tt.design.sub}</p>

      <div class="split" data-reveal>
        <div class="split__col">
          <h3 class="split__title">{tt.design.parallelTitle}</h3>
          <ul class="split__items">
            {tt.design.parallelItems.map((i) => <li class="mono">{i}</li>)}
          </ul>
          <p class="split__body">{tt.design.parallelBody}</p>
        </div>
        <div class="split__col">
          <h3 class="split__title">{tt.design.ownerTitle}</h3>
          <ul class="split__items">
            {tt.design.ownerItems.map((i) => <li class="mono">{i}</li>)}
          </ul>
          <p class="split__body">{tt.design.ownerBody}</p>
        </div>
      </div>

      <p class="quote" data-reveal>{tt.design.quote}</p>
    </div>
  </section>

  <!-- 06 CALENDARIO -->
  <section class="gsec">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">06</span><span class="sechead__label">{tt.calendar.label}</span>
      </div>
      <h2 class="gsec__title caret-type" data-reveal>{tt.calendar.title}</h2>

      {/* Rejilla del mes entero: los días apagados también se pintan, para que
          se vea de un vistazo cuánto ocupa el challenge dentro de agosto. Cada
          día marcado lleva escrito lo que pasa ese día, así que el color es un
          refuerzo y no la única fuente de información. */}
      <div class="cal" data-reveal>
        <p class="cal__month mono">{tt.calendar.month}</p>

        <div class="cal__grid" role="presentation">
          {tt.calendar.weekdays.map((w) => <span class="cal__wd mono">{w}</span>)}
          {Array.from({ length: month.lead }, () => <span class="cal__pad" />)}
          {month.cells.map((c) => (
            <span class:list={['cal__day', `is-${c.kind}`]}>
              <span class="cal__n mono">{c.day}</span>
              {c.kind !== 'idle' && <span class="cal__what mono">{tt.calendar.short[c.kind]}</span>}
            </span>
          ))}
          {Array.from({ length: trail }, () => <span class="cal__pad" />)}
        </div>
      </div>

      <p class="gfoot mono" data-reveal>{tt.calendar.tbd}</p>
    </div>
  </section>

  <!-- 07 CÓMO PARTICIPAR -->
  <section class="gsec" id="join">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">07</span><span class="sechead__label">{tt.join.label}</span>
      </div>
      <h2 class="gsec__title caret-type" data-reveal>{tt.join.title}</h2>
      <p class="gsec__sub" data-reveal>{tt.join.sub}</p>

      <ol class="steps" data-reveal-stagger>
        {tt.join.steps.map((s, i) => (
          <li class="steps__item">
            <span class="steps__n mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="steps__label">{s}</span>
          </li>
        ))}
      </ol>

      <div class="panel" data-reveal>
        <p class="panel__t mono">{tt.join.reqTitle}</p>
        <ul class="reqs">
          {tt.join.reqs.map((r) => <li class="reqs__item">{r}</li>)}
        </ul>
      </div>

      <div class="panel panel--v" data-reveal>
        <p class="panel__t mono">{tt.join.signupTitle}</p>
        <p class="panel__b">{tt.join.signupBody}</p>

        {formUrl ? (
          <>
            <a class="btn btn-primary panel__cta" href={formUrl} target="_blank" rel="noopener">
              {tt.form.cta} →
            </a>
            <p class="panel__note mono">{tt.form.note}</p>
          </>
        ) : (
          <p class="panel__note mono">{tt.form.soonTitle}: {tt.form.soon}</p>
        )}
      </div>
    </div>
  </section>

  <!-- 08 LA ENTREGA -->
  <section class="gsec">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">08</span><span class="sechead__label">{tt.submit.label}</span>
      </div>
      <h2 class="gsec__title caret-type" data-reveal>{tt.submit.title}</h2>
      <p class="gsec__sub" data-reveal>{tt.submit.sub}</p>

      <p class="gsublabel mono" data-reveal>{tt.submit.requiredLabel}</p>
      {/* Los dos últimos van destacados: en la fuente son los que prueban qué se
          construyó y cómo, y por eso cierran la rejilla. */}
      <ul class="fields" data-reveal-stagger>
        {tt.submit.required.map((f, i) => (
          <li class:list={['field-item', { 'is-key': i >= tt.submit.required.length - 2 }]}>{f}</li>
        ))}
      </ul>
      <p class="gnote" data-reveal>{tt.submit.requiredNote}</p>

      <p class="gsublabel mono" data-reveal>{tt.submit.recommendedLabel}</p>
      <ul class="recs" data-reveal-stagger>
        {tt.submit.recommended.map((r) => (
          <li class="recs__row">
            <span class="recs__name">{r.name}</span>
            <span class="recs__why">{r.why}</span>
          </li>
        ))}
      </ul>

      <p class="gfoot mono" data-reveal>{tt.submit.rule}</p>

      <ul class="fine" data-reveal>
        {tt.submit.notes.map((n) => <li>{n}</li>)}
      </ul>

      <div class="panel" data-reveal>
        <p class="panel__t mono">{tt.submit.whereTitle}</p>
        <p class="panel__b">{tt.submit.whereBody}</p>
      </div>
    </div>
  </section>

  <!-- 09 DESPUÉS DEL CIERRE -->
  <section class="gsec">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">09</span><span class="sechead__label">{tt.after.label}</span>
      </div>
      <h2 class="gsec__title caret-type" data-reveal>{tt.after.title}</h2>
      <p class="gsec__sub" data-reveal>{tt.after.sub}</p>

      <ol class="after" data-reveal-stagger>
        {tt.after.steps.map((s) => (
          <li class="after__step">
            <span class="after__when mono">{s.when}</span>
            <h3 class="after__name">{s.name}</h3>
            <p class="after__body">{s.body}</p>
          </li>
        ))}
      </ol>

      <div class="panel" data-reveal>
        <p class="panel__t mono">{tt.after.tbdLabel}</p>
        <p class="panel__b">{tt.after.tbdBody}</p>
      </div>

      {/* Sin botón de votar: la votación no está construida. El enlace lleva a
          donde va a pasar de verdad. */}
      <p class="gnote" data-reveal>{tt.after.note}</p>
      <a class="glink mono" href={communityHref} data-reveal>{tt.ctaVote} →</a>
    </div>
  </section>

  <!-- CIERRE -->
  <section class="gclose">
    <div class="container" data-reveal>
      <h2 class="gclose__title">{tt.close.title}</h2>
      <p class="gclose__text">{tt.close.text}</p>
      <div class="ghero__cta">
        <a
          class="btn btn-primary"
          href={cta.href}
          {...cta.external ? { target: '_blank', rel: 'noopener' } : {}}
        >
          {cta.label} →
        </a>
        <a class="btn btn-ghost" href={communityHref}>{tt.ctaSecondary} →</a>
      </div>
    </div>
  </section>
</NanPage>

<style>
  /* ---------- 00 HERO ---------- */
  .ghero { padding-block: clamp(32px, 5vh, 72px) clamp(48px, 7vh, 100px); }
  .ghero__title {
    margin-top: var(--space-4); font-family: var(--font-serif); font-weight: 400;
    color: var(--color-text); line-height: 0.92; letter-spacing: -0.02em; max-width: 14ch;
  }
  .ghero__sub {
    margin-top: var(--space-6); max-width: 52ch; color: var(--color-text);
    font-family: var(--font-serif); font-size: clamp(18px, 1.5vw, 22px); line-height: 1.5;
  }
  .ghero__chips { margin-top: var(--space-6); display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .chip {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px;
    font-size: 13px; color: var(--color-muted); border: 1px solid var(--color-line);
  }
  .chip--v {
    color: var(--color-violet-2); background: var(--color-violet-dim);
    border-color: color-mix(in srgb, var(--color-violet) 45%, transparent);
  }
  .ghero__cta { margin-top: var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .ghero__note { margin-top: var(--space-4); font-size: 12px; color: var(--color-muted); }

  /* ---------- secciones ---------- */
  .gsec { padding-block: clamp(48px, 7vh, 100px); }
  .gsec__title {
    font-family: var(--font-serif); font-weight: 400; color: var(--color-text);
    font-size: clamp(34px, 4.4vw, 64px); line-height: 1.02; letter-spacing: -0.01em; max-width: 20ch;
  }
  .gsec__sub {
    margin-top: var(--space-5); max-width: 60ch; color: var(--color-text);
    font-size: clamp(16px, 1.2vw, 19px); line-height: 1.6;
  }
  .gsublabel {
    margin-top: var(--space-10); font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--color-violet-2);
  }
  .gnote {
    margin-top: var(--space-6); max-width: 66ch; color: var(--color-muted);
    font-size: 15px; line-height: 1.65;
  }
  .gfoot {
    margin-top: var(--space-6); font-size: 12px; letter-spacing: 0.02em; color: var(--color-muted);
  }
  .quote {
    margin-top: var(--space-10); max-width: 46ch;
    border-left: 2px solid var(--color-violet); padding-left: var(--space-6);
    font-family: var(--font-serif); font-size: clamp(20px, 2vw, 28px);
    line-height: 1.3; color: var(--color-text);
  }
  .glink {
    display: inline-block; margin-top: var(--space-6); font-size: 13px;
    color: var(--color-link); border-bottom: 1px solid var(--color-link-line);
    transition: color var(--dur-micro) var(--ease), border-color var(--dur-micro) var(--ease);
  }
  .glink:hover { color: var(--color-text); border-bottom-color: var(--color-text); }

  /* ---------- 01 los ejemplos ----------
     Misma pantalla que las tarjetas de vídeo de /events (marco, líneas de
     barrido, triángulo de play): son vídeos, y el usuario ya sabe en esta web
     lo que significa esa caja. La diferencia es que estas SÍ son clicables,
     porque el vídeo está en otro sitio. */
  .shot { display: block; color: inherit; }
  .shot__screen {
    position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden;
    background:
      radial-gradient(120% 140% at 50% 0%, rgba(125,57,235,0.22), transparent 60%),
      var(--color-surface);
    border: 1px solid var(--color-line);
    transition: border-color var(--dur-ui) var(--ease);
  }
  .shot:hover .shot__screen { border-color: color-mix(in srgb, var(--color-violet) 55%, transparent); }
  .shot__img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: brightness(0.82) contrast(1.02);
    transition: filter var(--dur-ui) var(--ease), transform var(--dur-ui) var(--ease);
  }
  .shot:hover .shot__img { filter: brightness(1); transform: scale(1.03); }
  .shot__scan {
    position: absolute; inset: 0; opacity: 0.5;
    background: repeating-linear-gradient(0deg, rgba(255,255,255,0.05) 0 1px, transparent 1px 3px);
  }
  .shot__play {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 0; height: 0; border-left: 20px solid var(--color-violet-2);
    border-top: 12px solid transparent; border-bottom: 12px solid transparent;
    filter: drop-shadow(0 0 12px rgba(125,57,235,0.5));
    transition: transform var(--dur-ui) var(--ease);
  }
  .shot:hover .shot__play { transform: translate(-50%, -50%) scale(1.12); }
  .shot__badge {
    position: absolute; left: 8px; top: 8px; font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; color: #fff; background: var(--color-violet); padding: 3px 7px;
  }
  .shot__body { display: block; }
  .shot__title {
    display: block; margin-top: var(--space-4);
    font-family: var(--font-serif); font-weight: 400; color: var(--color-text);
    font-size: clamp(19px, 1.6vw, 24px); line-height: 1.1;
  }
  .shot__desc {
    display: block; margin-top: var(--space-3);
    color: var(--color-muted); font-size: 15px; line-height: 1.55;
  }
  /* El handle no es un adorno: es de quien es cada cosa. Por eso va siempre
     visible y no aparece solo al pasar por encima. */
  .shot__meta {
    display: block; margin-top: var(--space-3);
    font-size: 12px; letter-spacing: 0.02em; color: var(--color-violet-2);
    transition: color var(--dur-micro) var(--ease);
  }
  .shot:hover .shot__meta { color: var(--color-text); }

  /* El destacado: la pantalla a la izquierda y el texto al lado, para que se
     lea como una portada y no como una tarjeta más grande. */
  .shot--lead {
    margin-top: var(--space-10);
    display: grid; grid-template-columns: 1.35fr 1fr;
    gap: var(--space-8); align-items: center;
  }
  .shot--lead .shot__title { margin-top: 0; font-size: clamp(26px, 2.6vw, 40px); }
  .shot--lead .shot__desc { font-size: 16px; max-width: 42ch; }

  .shots {
    margin-top: var(--space-10); display: grid;
    grid-template-columns: repeat(4, 1fr); gap: var(--space-8) var(--space-6);
  }

  /* ---------- 02 las tres preguntas ----------
     Misma rejilla de hairlines que el resto: tres celdas para las tres cosas
     que hay que saber antes de seguir leyendo. */
  .qa {
    margin-top: var(--space-10);
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: var(--color-line); border: 1px solid var(--color-line);
  }
  .qa__card {
    background: var(--color-bg); padding: clamp(20px, 2.4vw, 32px);
    display: flex; flex-direction: column;
    transition: background var(--dur-ui) var(--ease);
  }
  .qa__card:hover { background: var(--color-surface); }
  .qa__q {
    font-family: var(--font-serif); font-weight: 400; color: var(--color-violet-2);
    font-size: clamp(18px, 1.7vw, 23px); line-height: 1.15;
  }
  .qa__a { margin-top: var(--space-4); color: var(--color-text); font-size: 15px; line-height: 1.65; }
  /* Anclado abajo: con respuestas de distinto largo, el enlace de la tercera
     tarjeta se quedaba a media altura y parecía de otra fila. */
  .qa__link {
    margin-top: auto; padding-top: var(--space-5); align-self: flex-start;
    font-size: 12px; color: var(--color-link);
    transition: color var(--dur-micro) var(--ease);
  }
  .qa__link:hover { color: var(--color-text); }

  /* ---------- 03 el prompt anotado ----------
     Una hoja con anotaciones al margen. Los seis colores de tinta son locales a
     esta sección a propósito: el sistema es violeta de arriba abajo, y aquí lo
     que se está reproduciendo es una captura llena de rotulador. Fuera de este
     bloque no deberían aparecer. */
  .frame {
    --ink-ref: #6ea8fe;
    --ink-fanout: #e8a33d;
    --ink-loop: #f08a8a;
    --ink-critic: #e8a33d;
    --ink-harsh: #e2685f;
    --ink-stack: #e2685f;
    --ink-ultra: #c08cf5;

    margin-top: var(--space-8); border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-surface) 60%, transparent);
  }
  .frame__title {
    padding: var(--space-5) var(--space-6) 0;
    font-size: 15px; font-weight: 700; color: var(--ink-ref);
  }

  .pr { padding: var(--space-5) var(--space-6) var(--space-6); }
  /* Tres columnas: nota — texto — nota. El texto manda y las notas viven de lo
     que sobra, así que el prompt nunca se estruja para dejar sitio a un margen. */
  .pr__row {
    display: grid; grid-template-columns: 1fr minmax(0, 34em) 1fr;
    gap: var(--space-5); align-items: start;
  }
  .pr__side { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-2); }
  .pr__row:nth-child(odd) .pr__side { justify-content: center; }
  .pr__p {
    font-family: var(--font-sans); font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.7; color: var(--color-text); margin: 0 0 var(--space-5);
  }
  /* `mark` trae fondo amarillo de serie: aquí solo subraya, como el rotulador
     de la captura. El grosor va en `text-decoration` para que el trazo siga a
     la línea cuando el texto se parte. */
  .ink {
    background: none; color: inherit;
    text-decoration: underline; text-decoration-thickness: 2px;
    text-underline-offset: 3px; text-decoration-color: var(--c);
  }
  .ink.is-ref { --c: var(--ink-ref); }
  .ink.is-fanout { --c: var(--ink-fanout); }
  .ink.is-loop { --c: var(--ink-loop); }
  .ink.is-critic { --c: var(--ink-critic); }
  .ink.is-harsh { --c: var(--ink-harsh); }
  .ink.is-stack { --c: var(--ink-stack); }
  .ink.is-ultra { --c: var(--ink-ultra); }

  /* La rotación es lo que hace que se lean como escritas encima y no como una
     columna más de la maqueta. Se van alternando para que no parezcan un
     bloque inclinado entero. */
  .note {
    margin: 0; font-family: var(--font-mono); font-size: 13px; line-height: 1.45;
    color: var(--c); transform: rotate(-1.4deg); transform-origin: left center;
  }
  .pr__side:last-child .note { transform: rotate(1.2deg); }
  .note__arrow { opacity: 0.8; padding-inline: 6px; font-size: 15px; }
  .note.is-ref { --c: var(--ink-ref); }
  .note.is-fanout { --c: var(--ink-fanout); }
  .note.is-loop { --c: var(--ink-loop); }
  .note.is-critic { --c: var(--ink-critic); }
  .note.is-harsh { --c: var(--ink-harsh); }
  .note.is-ultra { --c: var(--ink-ultra); }

  .frame__foot {
    border-top: 1px solid var(--color-line); padding: var(--space-5) var(--space-6);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-5);
  }
  .copy { border: none; cursor: pointer; font: inherit; }
  .copy[data-state='done'] { background: var(--color-violet); color: #fff; }
  .copy__note { font-size: 12px; color: var(--color-muted); max-width: 46ch; }

  /* ---------- 04 el loop: tira de 5 celdas, como la del calendario ---------- */
  .loop {
    list-style: none; margin: var(--space-10) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(5, 1fr);
    gap: 1px; background: var(--color-line); border: 1px solid var(--color-line);
  }
  .loop__step {
    background: var(--color-bg); padding: var(--space-6);
    transition: background var(--dur-ui) var(--ease);
  }
  .loop__step:hover { background: var(--color-surface); }
  .loop__n { font-size: 12px; color: var(--color-violet-2); font-weight: 700; }
  .loop__name {
    margin-top: var(--space-3); font-family: var(--font-serif); font-weight: 400;
    color: var(--color-text); font-size: clamp(19px, 1.8vw, 24px); line-height: 1.1;
  }
  .loop__body { margin-top: var(--space-3); color: var(--color-muted); font-size: 14px; line-height: 1.6; }

  /* ---------- 05 dos columnas enfrentadas ---------- */
  .split {
    margin-top: var(--space-10); display: grid; grid-template-columns: 1fr 1fr;
    gap: 1px; background: var(--color-line); border: 1px solid var(--color-line);
  }
  .split__col { background: var(--color-bg); padding: clamp(24px, 3vw, 40px); }
  .split__title {
    font-family: var(--font-serif); font-weight: 400; color: var(--color-text);
    font-size: clamp(20px, 2vw, 28px); line-height: 1.1;
  }
  .split__items { list-style: none; margin: var(--space-5) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .split__items li {
    font-size: 12px; color: var(--color-violet-2); padding: 4px 9px;
    border: 1px solid color-mix(in srgb, var(--color-violet) 45%, transparent);
    background: var(--color-violet-dim);
  }
  .split__body { margin-top: var(--space-5); color: var(--color-muted); font-size: 15px; line-height: 1.65; }

  /* ---------- 06 calendario del mes ----------
     Rejilla de 7 columnas con las hairlines de 1px del sistema: el fondo del
     contenedor se ve a través de los huecos del `gap`, que es como está hecha
     la tira del loop y la rejilla de campos.

     El mes entero tiene que caber en una pantalla junto con su título, así que
     la altura de la casilla se mide en `vh` y no en proporción: con celdas
     cuadradas seis filas se comían el viewport de largo. El ancho también está
     capado —un calendario a 1200px son celdas enormes con una palabra dentro. */
  .cal {
    margin-top: var(--space-8); border: 1px solid var(--color-line);
    max-width: 780px;
  }
  .cal__month {
    padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--color-line);
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-violet-2);
  }
  .cal__grid {
    display: grid; grid-template-columns: repeat(7, 1fr);
    gap: 1px; background: var(--color-line);
  }
  .cal__wd {
    background: var(--color-bg); padding: var(--space-2) 0; text-align: center;
    font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted);
  }
  .cal__pad { background: var(--color-bg); }
  .cal__day {
    background: var(--color-bg); min-height: clamp(46px, 7.2vh, 62px);
    padding: 5px 6px; display: flex; flex-direction: column; gap: 2px;
    transition: background var(--dur-micro) var(--ease);
  }
  .cal__n { font-size: 12px; line-height: 1; color: var(--color-muted); }
  /* La etiqueta se ancla abajo para que los números queden todos en la misma
     línea, tengan texto debajo o no. */
  .cal__what {
    margin-top: auto; font-size: 9px; line-height: 1.15; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--color-violet-2);
  }
  /* Los días sin nada siguen pintados pero apagados: dan la forma del mes. */
  .cal__day.is-idle .cal__n { opacity: 0.35; }
  .cal__day.is-build { background: var(--color-violet-dim); }
  .cal__day.is-build .cal__n { color: var(--color-violet-2); }
  /* "Construir" se repite veinte días seguidos: bajarle el peso evita que la
     rejilla se lea como veinte avisos en vez de como un tramo continuo. */
  .cal__day.is-build .cal__what,
  .cal__day.is-voting .cal__what { opacity: 0.6; }
  /* El kickoff va marcado con un anillo y el cierre en sólido: son los dos
     hitos duros del mes y tienen que distinguirse entre sí, no solo del resto. */
  .cal__day.is-workshop {
    background: var(--color-violet-dim); box-shadow: inset 0 0 0 2px var(--color-violet);
  }
  .cal__day.is-workshop .cal__n { color: var(--color-violet-2); font-weight: 700; }
  .cal__day.is-close { background: var(--color-violet); }
  .cal__day.is-close .cal__n,
  .cal__day.is-close .cal__what { color: #fff; font-weight: 700; }
  .cal__day.is-voting { background: color-mix(in srgb, var(--color-violet) 22%, transparent); }
  .cal__day.is-voting .cal__n { color: var(--color-text); }

  /* ---------- 07 pasos + paneles ---------- */
  .steps {
    list-style: none; margin: var(--space-10) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(5, 1fr);
    gap: 1px; background: var(--color-line); border: 1px solid var(--color-line);
  }
  .steps__item {
    background: var(--color-bg); padding: var(--space-5);
    display: flex; flex-direction: column; gap: var(--space-3);
  }
  .steps__n { font-size: 12px; color: var(--color-violet-2); font-weight: 700; }
  .steps__label { font-family: var(--font-serif); font-size: clamp(16px, 1.4vw, 20px); color: var(--color-text); line-height: 1.15; }

  .panel { margin-top: var(--space-8); border: 1px solid var(--color-line); padding: clamp(20px, 2.4vw, 32px); }
  .panel--v {
    border-color: color-mix(in srgb, var(--color-violet) 45%, transparent);
    background: var(--color-violet-dim);
  }
  .panel__t { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-violet-2); }
  .panel__b { margin-top: var(--space-4); max-width: 68ch; color: var(--color-text); font-size: 16px; line-height: 1.65; }
  .panel__cta { margin-top: var(--space-6); }
  .panel__note { margin-top: var(--space-4); font-size: 12px; line-height: 1.6; color: var(--color-muted); }

  .reqs { list-style: none; margin: var(--space-4) 0 0; padding: 0; }
  .reqs__item {
    position: relative; padding-left: 20px; margin-top: var(--space-3);
    color: var(--color-text); font-size: 16px; line-height: 1.6;
  }
  .reqs__item::before {
    content: ''; position: absolute; left: 0; top: 0.6em;
    width: 7px; height: 7px; background: var(--color-violet);
  }

  /* ---------- 08 entrega ---------- */
  .fields {
    list-style: none; margin: var(--space-5) 0 0; padding: 0;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 1px; background: var(--color-line); border: 1px solid var(--color-line);
  }
  .field-item {
    background: var(--color-bg); padding: var(--space-5);
    font-family: var(--font-serif); font-size: clamp(16px, 1.4vw, 20px);
    color: var(--color-text); line-height: 1.2;
  }
  .field-item.is-key { background: var(--color-violet-dim); color: var(--color-violet-2); }

  .recs { list-style: none; margin: var(--space-5) 0 0; padding: 0; border-top: 1px solid var(--color-line); }
  .recs__row {
    display: grid; grid-template-columns: 240px 1fr; gap: var(--space-4);
    align-items: baseline; padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }
  .recs__name { font-family: var(--font-serif); font-size: clamp(16px, 1.4vw, 20px); color: var(--color-text); }
  .recs__why { color: var(--color-muted); font-size: 15px; line-height: 1.6; }

  .fine { list-style: none; margin: var(--space-6) 0 0; padding: 0; max-width: 72ch; }
  .fine li {
    position: relative; padding-left: 16px; margin-top: var(--space-3);
    color: var(--color-muted); font-size: 14px; line-height: 1.65;
  }
  .fine li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 8px; height: 1px; background: var(--color-muted); }

  /* ---------- 09 después del cierre ---------- */
  .after {
    list-style: none; margin: var(--space-10) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: var(--color-line); border: 1px solid var(--color-line);
  }
  .after__step { background: var(--color-bg); padding: clamp(20px, 2.4vw, 32px); }
  .after__when { font-size: 12px; color: var(--color-violet-2); letter-spacing: 0.04em; }
  .after__name {
    margin-top: var(--space-3); font-family: var(--font-serif); font-weight: 400;
    color: var(--color-text); font-size: clamp(20px, 2vw, 27px); line-height: 1.1;
  }
  .after__body { margin-top: var(--space-3); color: var(--color-muted); font-size: 15px; line-height: 1.6; }

  /* ---------- cierre ---------- */
  .gclose { padding-block: clamp(56px, 9vh, 130px); }
  .gclose__title {
    font-family: var(--font-serif); font-weight: 400; color: var(--color-text);
    font-size: clamp(40px, 6vw, 88px); line-height: 0.98; letter-spacing: -0.02em; max-width: 16ch;
  }
  .gclose__text {
    margin-top: var(--space-5); max-width: 52ch; color: var(--color-text);
    font-family: var(--font-serif); font-size: clamp(17px, 1.3vw, 20px); line-height: 1.55;
  }

  /* Las tiras de 5 celdas se parten antes que el resto: a 1100px ya no entran
     sin que el texto se rompa en columnas de dos palabras. El calendario NO se
     reordena en ningún punto — siete columnas son siete días, y una semana
     partida deja de ser un calendario. */
  @media (max-width: 1100px) {
    .loop, .steps { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .after { grid-template-columns: 1fr; }
    /* El destacado deja de estar enfrentado y pasa a ser portada + pie. En dos
       columnas estrechas la descripción se rompía en renglones de tres
       palabras al lado de una pantalla ya diminuta. */
    .shot--lead { grid-template-columns: 1fr; gap: 0; }
    .shot--lead .shot__title { margin-top: var(--space-4); }
    .shots { grid-template-columns: repeat(2, 1fr); }
    /* Con dos columnas la tercera pregunta se queda sola en su fila y la
       rejilla se lee rota; apiladas siguen siendo tres respuestas seguidas. */
    .qa { grid-template-columns: 1fr; }
    .split { grid-template-columns: 1fr; }
    .recs__row { grid-template-columns: 160px 1fr; }
    /* Sin márgenes que den para una nota, cada anotación baja debajo del
       párrafo que anota —que es el único sitio donde se sigue entendiendo a
       qué se refiere— y las flechas dejan de apuntar a nada. */
    .pr__row { grid-template-columns: 1fr; gap: var(--space-3); }
    .pr__p { order: -1; }
    .pr__side { flex-direction: row; flex-wrap: wrap; gap: var(--space-3) var(--space-5); padding: 0; }
    /* Centrada tenía sentido colgando de un margen; en una columna, la nota se
       alinea con el párrafo del que cuelga. */
    .pr__row:nth-child(odd) .pr__side { justify-content: flex-start; }
    .pr__side:empty { display: none; }
    .pr__p { margin-bottom: var(--space-3); }
    /* En una columna, una nota está pegada a dos párrafos: al suyo, arriba, y al
       siguiente. El aire entre bloques es lo único que dice cuál de los dos. */
    .pr__row + .pr__row { margin-top: var(--space-6); }
    .note { transform: none; }
    .pr__side:last-child .note { transform: none; }
    .note__arrow { display: none; }
    .note::before { content: '↳ '; opacity: 0.7; }
  }
  @media (max-width: 620px) {
    .loop, .steps { grid-template-columns: repeat(2, 1fr); }
    .shots { grid-template-columns: 1fr; }
    .fields { grid-template-columns: 1fr; }
    .recs__row { grid-template-columns: 1fr; gap: var(--space-1); }
    .cal__month { padding-inline: var(--space-4); }
  }
  /* Por debajo de aquí la columna mide ~45px y "CONSTRUIR" ya no cabe sin
     partirse en tres líneas. Se quedan solo las etiquetas de los dos hitos,
     que son cortas; el tramo largo lo sigue contando el color. */
  @media (max-width: 520px) {
    .cal__day { min-height: 42px; padding: 4px; }
    .cal__day.is-build .cal__what, .cal__day.is-voting .cal__what { display: none; }
    .cal__what { font-size: 8px; letter-spacing: 0.02em; }
  }
</style>

<script>
  /**
   * Copiar el prompt. Es todo el JavaScript que tiene la página: no manda nada
   * a ninguna parte, solo escribe en el portapapeles del que pulsa.
   *
   * El texto viaja en `data-prompt`, generado a partir de la misma lista que
   * se pinta arriba. Si el navegador niega el portapapeles —permiso denegado,
   * o un contexto no seguro— se selecciona el prompt entero y el botón lo dice,
   * que es mejor que fingir que ha funcionado.
   */
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-prompt]');
  const label = btn?.querySelector<HTMLElement>('.copy__label');

  let restore: ReturnType<typeof setTimeout> | undefined;

  btn?.addEventListener('click', async () => {
    if (!label) return;
    const text = btn.dataset.prompt ?? '';
    let ok = true;

    try {
      await navigator.clipboard.writeText(text);
    } catch {
      ok = false;
      const body = document.querySelector('.pr');
      const sel = window.getSelection();
      if (body && sel) {
        const range = document.createRange();
        range.selectNodeContents(body);
        sel.removeAllRanges();
        sel.addRange(range);
      }
    }

    label.textContent = ok ? (btn.dataset.done ?? '') : (btn.dataset.fail ?? '');
    btn.dataset.state = ok ? 'done' : 'fail';

    clearTimeout(restore);
    restore = setTimeout(() => {
      label.textContent = btn.dataset.label ?? '';
      delete btn.dataset.state;
    }, 2600);
  });
</script>
