---
import NanPage from '../layouts/NanPage.astro';
import CommunitySignupForm from '../components/landing/CommunitySignupForm.tsx';
import { getLang, useT, t } from '../lib/i18n';
// La isla del formulario sigue escrita con utilidades de Tailwind; el tema de
// Tailwind está apuntado a nuestros tokens (ver styles/global.css).
import '../styles/global.css';
import { MEMBERS_NOW, MEMBERS_GOAL, membersPct } from '../lib/members';

const lang = getLang(Astro.url);
const tt = useT(lang).community;

// El formulario de alta es de este repo, no venía en el rediseño: se conserva
// tal cual, con sus strings, porque es el punto de conversión de la página.
const formStrings = {
  emailLabel: t('community.emailLabel', lang),
  emailPlaceholder: t('community.emailPlaceholder', lang),
  regionLabel: t('community.regionLabel', lang),
  regionEU: t('community.regionEU', lang),
  regionUSA: t('community.regionUSA', lang),
  regionLATAM: t('community.regionLATAM', lang),
  regionDefault: t('community.regionDefault', lang),
  submit: t('community.submit', lang),
  submitting: t('community.submitting', lang),
  redirecting: t('community.redirecting', lang),
  alreadySubscribed: t('community.alreadySubscribed', lang),
  alreadyMemberLabel: t('community.alreadyMemberLabel', lang),
  honeypot: t('community.honeypot', lang),
  errorInvalidEmail: t('community.errorInvalidEmail', lang),
  errorInvalidRegion: t('community.errorInvalidRegion', lang),
  errorRateLimited: t('community.errorRateLimited', lang),
  errorServer: t('community.errorServer', lang),
  errorNetwork: t('community.errorNetwork', lang),
};

const joinHref = '#signup';

// La cuenta de miembros se actualiza a mano al alcanzar un hito y NO se
// traduce, así que vive en lib/members y no en el diccionario, donde estaba
// duplicada en los dos idiomas y podía divergir.
const pct = membersPct();
---

<NanPage title={tt.metaTitle} description={tt.metaDesc}>
  <!-- HERO -->
  <header class="chero">
    <div class="container chero__inner" data-reveal>
      <p class="eyebrow">{tt.heroEyebrow}</p>
      <h1 class="chero__title">{tt.heroTitle}</h1>
      <p class="chero__sub">{tt.heroSub}</p>
      <div class="chero__cta">
        <a class="btn btn-primary" href={joinHref}>{tt.ctaPrimary} →</a>
        <a class="btn btn-ghost" href="#roadmap">{tt.ctaSecondary} →</a>
      </div>
    </div>
  </header>

  <!-- QUÉ PASA AQUÍ -->
  <section class="csec">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">01</span><span class="sechead__label">{tt.whatLabel}</span>
      </div>
      <h2 class="csec__title caret-type" data-reveal>{tt.whatTitle}</h2>
      <p class="csec__intro" data-reveal>{tt.whatIntro}</p>

      <div class="pillars" data-reveal-stagger>
        {tt.pillars.map((p, i) => (
          <article class="pillar">
            <div class="pillar__head">
              <h3 class="pillar__name">{p.name}</h3>
              <span class="pillar__ico" aria-hidden="true">
                {i === 0 && (
                  <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor">
                    <path d="M20.317 4.369a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.106c.36.699.772 1.363 1.225 1.994a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
                  </svg>
                )}
                {i === 1 && (
                  <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3.5" y="5" width="17" height="15.5" />
                    <line x1="3.5" y1="9.5" x2="20.5" y2="9.5" />
                    <line x1="8" y1="3" x2="8" y2="6.5" />
                    <line x1="16" y1="3" x2="16" y2="6.5" />
                  </svg>
                )}
                {i === 2 && (
                  <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 3.4h12.6L20.6 7.4V20.6H4z" />
                    <path d="M8 3.4h6.4v4.2H8z" fill="currentColor" stroke="none" />
                    <rect x="7" y="12" width="10" height="6.6" />
                    <line x1="9.4" y1="14.4" x2="14.6" y2="14.4" />
                  </svg>
                )}
                {i === 3 && (
                  <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4.5 8.5h11v4.5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V8.5z" />
                    <path d="M15.5 9.5H18a2.5 2.5 0 0 1 0 5h-2.5" />
                    <line x1="7.5" y1="2.8" x2="7.5" y2="5.4" />
                    <line x1="11" y1="2.8" x2="11" y2="5.4" />
                  </svg>
                )}
              </span>
            </div>
            <p class="pillar__body">{p.body}</p>
            <span class="pillar__freq mono">{p.freq}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- EN MARCHA -->
  <section class="csec">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">02</span><span class="sechead__label">{tt.progressLabel}</span>
      </div>
      <h2 class="csec__title caret-type" data-reveal>{tt.progressTitle}</h2>
      <p class="csec__intro" data-reveal>{tt.progressIntro}</p>

      <div class="inits" data-reveal-stagger>
        {tt.initiatives.map((it, j) => (
          <article class="init">
            <div class="init__top">
              <span class="init__ico" aria-hidden="true">
                {j === 0 && (
                  <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
                    <path d="M12 2.5c2.5 2 4 5.5 4 9v3.5H8V11.5c0-3.5 1.5-7 4-9z" />
                    <circle cx="12" cy="9.4" r="1.7" />
                    <path d="M8 15l-3 2.6c0-2.4.3-3.6 1.2-4.4" />
                    <path d="M16 15l3 2.6c0-2.4-.3-3.6-1.2-4.4" />
                    <path d="M10 18.4c.3 1.8 2 3.1 2 3.1s1.7-1.3 2-3.1" />
                  </svg>
                )}
                {j === 1 && (
                  <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="11" cy="11" r="6.5" />
                    <ellipse cx="11" cy="11" rx="10.4" ry="3.3" transform="rotate(-25 11 11)" />
                  </svg>
                )}
                {j === 2 && (
                  <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                    <path d="M3 6.5h6l2 2.5h10V19H3z" />
                  </svg>
                )}
              </span>
              <h3 class="init__name">{it.name}</h3>
              <span class="init__tag mono">{tt.inProgressTag}</span>
            </div>
            <p class="init__body">{it.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ROADMAP -->
  <section class="csec" id="roadmap">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">03</span><span class="sechead__label">{tt.roadmapLabel}</span>
      </div>
      <h2 class="csec__title caret-type" data-reveal>{tt.roadmapTitle}</h2>
      <p class="csec__intro" data-reveal>{tt.roadmapIntro}</p>

      <div class="rterm" data-reveal>
        <div class="rterm__top">
          <span class="rterm__dot is-v" aria-hidden="true"></span>
          <span class="rterm__dot" aria-hidden="true"></span>
          <span class="rterm__dot" aria-hidden="true"></span>
          <span class="rterm__path">nan@community: ~/roadmap</span>
        </div>
        <div class="rterm__body">
          <p class="rterm__line"><span class="rterm__p">$</span> nan status --members</p>
          <div class="rterm__bar-row">
            <span class="rterm__k">{tt.membersLabel}</span>
            <span class="rterm__bar"><i style={`width:${pct}%`}></i></span>
            <span class="rterm__v">{MEMBERS_NOW} / {MEMBERS_GOAL}</span>
          </div>
          <p class="rterm__line"><span class="rterm__p">$</span> nan roadmap --all</p>

          <div class="rtable">
            <div class="rtable__head mono">
              <span>{tt.roadmapColInitiative}</span>
              <span>{tt.roadmapColStatus}</span>
            </div>
            {tt.roadmap.map((r) => (
              <div class="rrow">
                <div class="rrow__main">
                  <span class="rrow__init">{r.initiative}</span>
                  <span class="rrow__detail">{r.detail}</span>
                </div>
                <span class:list={['rrow__status mono', `is-${r.status}`]}>{r.status}</span>
              </div>
            ))}
          </div>

          <p class="rterm__line rterm__prompt"><span class="rterm__p">$</span> <span class="rterm__cursor">_</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- CIERRE -->
  <section class="cclose" id="signup">
    <div class="container cclose__inner" data-reveal>
      <h2 class="cclose__title">{tt.closeTitle}</h2>
      <p class="cclose__text">{tt.closeText}</p>
      <div class="cclose__form">
        <div class="cclose__price">
          <span class="cclose__amount">{t('community.priceLabel', lang)}</span>
          <span class="cclose__note">{t('community.priceTaxNote', lang)}</span>
        </div>
        <CommunitySignupForm client:load t={formStrings} />
        <p class="cclose__footer">{t('community.footer', lang)}</p>
      </div>
    </div>
  </section>
</NanPage>

<style>
  /* ---------- HERO ---------- */
  .chero { padding-block: clamp(48px, 8vh, 120px) clamp(40px, 6vh, 88px); }
  .chero__title {
    margin-top: var(--space-4); font-family: var(--font-serif); font-weight: 400;
    color: var(--color-text); font-size: clamp(48px, 8vw, 116px);
    line-height: 0.92; letter-spacing: -0.02em; max-width: 16ch;
  }
  .chero__sub {
    margin-top: var(--space-6); max-width: 52ch; color: var(--color-text);
    font-family: var(--font-serif); font-size: clamp(18px, 1.5vw, 22px); line-height: 1.5;
  }
  .chero__cta { margin-top: var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-4); }

  /* ---------- SECCIONES ---------- */
  .csec { padding-block: clamp(48px, 7vh, 100px); }
  .csec__title {
    font-family: var(--font-serif); font-weight: 400; color: var(--color-text);
    font-size: clamp(34px, 4.4vw, 64px); line-height: 1.02; letter-spacing: -0.01em; max-width: 20ch;
  }
  .csec__intro {
    margin-top: var(--space-5); max-width: 60ch; color: var(--color-text);
    font-size: clamp(16px, 1.2vw, 19px); line-height: 1.6;
  }

  /* pilares */
  .pillars {
    margin-top: var(--space-12); display: grid; grid-template-columns: 1fr 1fr;
    gap: 1px; background: var(--color-line); border: 1px solid var(--color-line);
  }
  .pillar {
    background: var(--color-bg); padding: clamp(24px, 3vw, 40px);
    display: flex; flex-direction: column;
    transition: background var(--dur-ui) var(--ease);
  }
  .pillar:hover { background: var(--color-surface); }
  .pillar__head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); }
  .pillar__name {
    font-family: var(--font-serif); font-weight: 400; color: var(--color-text);
    font-size: clamp(22px, 2.2vw, 30px); line-height: 1.1;
  }
  .pillar__ico { flex: 0 0 auto; display: inline-flex; color: var(--color-violet); transition: transform var(--dur-ui) var(--ease); }
  .pillar__ico svg { display: block; }
  .pillar:hover .pillar__ico { transform: translateY(-3px); }
  .pillar__body { margin-top: var(--space-4); color: var(--color-text); font-size: 16px; line-height: 1.65; flex: 1; }
  .pillar__freq {
    margin-top: var(--space-6); font-size: 12px; letter-spacing: 0.03em; color: var(--color-violet-2);
  }

  /* iniciativas en marcha */
  .inits { margin-top: var(--space-12); display: flex; flex-direction: column; gap: 0; border-top: 1px solid var(--color-line); }
  .init {
    display: grid; grid-template-columns: 260px 1fr; gap: var(--space-8);
    align-items: start; padding: var(--space-8) var(--space-4);
    border-bottom: 1px solid var(--color-line);
    transition: background var(--dur-micro) var(--ease);
  }
  .init:hover { background: color-mix(in srgb, var(--color-violet) 6%, transparent); }
  .init__top { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .init__ico { display: inline-flex; color: var(--color-violet); }
  .init__ico svg { display: block; }
  .init__name {
    font-family: var(--font-serif); font-weight: 400; color: var(--color-text);
    font-size: clamp(24px, 2.6vw, 34px); line-height: 1.05;
  }
  .init__tag {
    font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-violet-2);
    border: 1px solid color-mix(in srgb, var(--color-violet) 45%, transparent);
    background: var(--color-violet-dim); padding: 3px 9px;
  }
  .init__body { max-width: 74ch; color: var(--color-text); font-size: 16px; line-height: 1.7; }

  /* roadmap: terminal + barra de progreso (sin ASCII) */
  .rterm {
    margin-top: var(--space-10); border: 1px solid var(--color-line);
    background: var(--color-surface); font-family: var(--font-mono); font-size: 14px;
  }
  .rterm__top {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 16px; border-bottom: 1px solid var(--color-line);
  }
  .rterm__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--color-line); }
  .rterm__dot.is-v { background: var(--color-violet); }
  .rterm__path { margin-left: 8px; font-size: 12px; color: var(--color-muted); }
  .rterm__body { padding: var(--space-6); overflow-x: auto; }
  .rterm__line { color: var(--color-muted); }
  .rterm__p { color: var(--color-violet-2); margin-right: 8px; }
  .rterm__prompt { margin-top: var(--space-5); }
  .rterm__cursor { display: inline-block; width: 8px; color: var(--color-violet-2); animation: rterm-blink 1.1s steps(1) infinite; }
  @keyframes rterm-blink { 50% { opacity: 0; } }
  .rterm__bar-row { display: flex; align-items: center; gap: var(--space-4); margin-block: var(--space-4); flex-wrap: wrap; }
  .rterm__k { color: var(--color-muted); }
  .rterm__bar { flex: 1; min-width: 180px; height: 8px; background: var(--color-violet-dim); position: relative; }
  .rterm__bar i { position: absolute; inset: 0 auto 0 0; background: var(--color-violet); }
  .rterm__v { color: var(--color-violet-2); }

  /* tabla roadmap: filas con hairline, dentro del terminal */
  .rtable { margin-top: var(--space-6); border-top: 1px solid var(--color-line); }
  .rtable__head {
    display: flex; justify-content: space-between; font-size: 11px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-muted); padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }
  .rrow {
    display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-6);
    padding-block: var(--space-5); border-bottom: 1px solid var(--color-line);
  }
  .rrow__main { display: flex; flex-direction: column; gap: 4px; }
  .rrow__init { font-family: var(--font-serif); font-size: clamp(18px, 1.6vw, 22px); color: var(--color-text); }
  .rrow__detail { color: var(--color-muted); font-size: 14px; line-height: 1.5; max-width: 68ch; }
  .rrow__status {
    flex: 0 0 auto; font-size: 11px; letter-spacing: 0.04em; padding: 4px 9px;
    border: 1px solid var(--color-line); color: var(--color-muted); white-space: nowrap;
  }
  .rrow__status.is-in_progress { color: var(--color-violet-2); border-color: color-mix(in srgb, var(--color-violet) 55%, transparent); background: var(--color-violet-dim); }
  .rrow__status.is-next { color: var(--color-text); border-color: var(--color-muted); }
  .rrow__status.is-soon { color: var(--color-muted); border-color: var(--color-line); }
  .rrow__status.is-planned { color: var(--color-muted); border-style: dashed; }

  /* cierre */
  .cclose { padding-block: clamp(56px, 9vh, 130px); }
  .cclose__title {
    font-family: var(--font-serif); font-weight: 400; color: var(--color-text);
    font-size: clamp(40px, 6vw, 88px); line-height: 0.98; letter-spacing: -0.02em;
    max-width: 16ch;
  }
  .cclose__text {
    margin-top: var(--space-5); max-width: 52ch; color: var(--color-text);
    font-family: var(--font-serif); font-size: clamp(17px, 1.3vw, 20px); line-height: 1.55;
  }
  .cclose .btn { margin-top: var(--space-8); }
  .cclose__form { margin-top: var(--space-8); max-width: 460px; }
  .cclose__price { display: flex; flex-direction: column; gap: var(--space-1); margin-bottom: var(--space-4); }
  .cclose__amount { font-family: var(--font-mono); font-size: 18px; font-weight: 600; color: var(--color-text); }
  .cclose__note { font-family: var(--font-mono); font-size: 12px; color: var(--color-text-dim); }
  .cclose__footer { margin-top: var(--space-3); font-family: var(--font-mono); font-size: 11px; color: var(--color-muted); text-align: center; }

  @media (max-width: 760px) {
    .pillars { grid-template-columns: 1fr; }
    .init { grid-template-columns: 1fr; gap: var(--space-4); padding-inline: 0; }
    .rrow { flex-direction: column; gap: var(--space-3); }
  }
</style>
