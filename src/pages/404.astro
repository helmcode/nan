---
/**
 * 404 del rediseño.
 *
 * Una sola página cubre los dos idiomas: `getLang` lee el path, así que
 * `/es/lo-que-sea` cae aquí y sale en español sin necesidad de un `/es/404`.
 *
 * Va con `noindex` (y sin canonical, que NanBase ya omite cuando noindex está
 * puesto): la página no debe indexarse, pero sí se sigue enlazando desde ella.
 */
import NanPage from '../layouts/NanPage.astro';
import { getLang, useT } from '../lib/i18n';

const lang = getLang(Astro.url);
const t = useT(lang);
const tt = t.notFound;
const a11y = t.a11y;
const home = lang === 'es' ? '/es' : '/';
---

<NanPage title={tt.metaTitle} description={tt.body} noindex>
  <section class="nf">
    <div class="container nf__grid">
      <div class="nf__col" data-reveal>
        <p class="eyebrow">{tt.eyebrow}</p>
        <h1 class="nf__title">{tt.title1}<br /><span class="hl">{tt.title2}</span></h1>
        <p class="nf__sub">{tt.body}</p>
        <div class="nf__actions">
          <a href={home} class="btn btn-primary">{tt.back}</a>
          <a href={`${home}#waitlist`} class="btn btn-ghost">{tt.join}</a>
        </div>
        <p class="nf__code mono">&gt; NaN === NaN // false</p>
      </div>

      <figure class="nf__fig" data-reveal>
        <img
          class="nf__img"
          src="/img/404-crt.webp"
          alt={a11y.crt404}
          loading="eager"
          width="1280"
          height="768"
        />
      </figure>
    </div>
  </section>
</NanPage>

<style>
  .nf {
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    align-items: center;
    padding-block: clamp(48px, 8vh, 110px);
  }

  .nf__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }

  .nf__col { max-width: 40ch; }

  /* El tamaño del titular lo gobierna la escala global de .nan-scale; aquí solo
     va lo que no es tipografía de sistema. */
  .nf__title {
    margin-top: var(--space-4);
    color: var(--color-text);
  }

  .nf__sub {
    margin-top: var(--space-6);
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.5;
    color: var(--color-text);
    max-width: 42ch;
  }

  .nf__actions {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .nf__code {
    margin-top: var(--space-8);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--color-link);
  }

  .nf__fig {
    margin: 0;
    border: 1px solid var(--color-line);
    background: var(--color-black);
    overflow: hidden;
  }
  .nf__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .nf__grid { grid-template-columns: 1fr; gap: clamp(28px, 6vw, 48px); }
    .nf__fig { order: -1; }
    .nf__col { max-width: none; }
  }
</style>
