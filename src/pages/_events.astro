---
import NanPage from '../layouts/NanPage.astro';
import eventos from '../data/eventos.json';
import { getLang, useT } from '../lib/i18n';
import {
  calendarDays,
  loc as resolve,
  spanLabel,
  upcomingIn,
  type AgendaItem,
  type Localized,
} from '../lib/agenda';

const lang = getLang(Astro.url);
const tt = useT(lang).events;
const a11y = useT(lang).a11y;
const loc = (v: Localized) => resolve(v, lang);

type VideoCard = {
  title: Localized;
  desc?: Localized;
  date: string;
  duration: string;
  thumb: string;
  tags: string[];
};
const workshops: VideoCard[] = eventos.workshops;
const events: VideoCard[] = eventos.events;

// Calendario real de los próximos 30 días. La página NO está prerenderizada,
// así que esto se recalcula en cada petición, con el reloj del Worker (UTC):
// para quien esté en Canarias o LATAM cerca de medianoche, "hoy" puede ir un
// día adelantado. Si algún día se prerenderiza, el calendario sí se congelaría
// en el build y habría que moverlo a cliente o a una isla.
const agenda: AgendaItem[] = eventos.agenda ?? [];
const today = new Date();
const days = calendarDays(agenda, today);
const upcoming = upcomingIn(agenda, today);

const hack = eventos.hackathons[0];
---

<NanPage title={tt.metaTitle} description={tt.metaDesc}>
  <!-- HERO: tele dithered con glitch de pantalla -->
  <header class="ehero">
    <div class="container ehero__inner">
      <div class="ehero__copy" data-reveal>
        <p class="eyebrow">{tt.heroEyebrow}</p>
        <h1 class="ehero__title">{tt.heroTitle1}<br /><span class="hl">{tt.heroTitle2}</span></h1>
        <p class="ehero__sub">{tt.heroSub}</p>
      </div>
    </div>
  </header>

  <!-- THIS MONTH: calendario teaser bloqueado (solo miembros) -->
  <section class="emonth">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">01</span><span class="sechead__label">{tt.monthLabel}</span>
      </div>
      <h2 class="emonth__title caret-type" data-reveal>{tt.monthTitle}</h2>
      <p class="emonth__sub" data-reveal>{tt.monthSub}</p>

      <div class="cal" data-reveal>
        <div class="cal__strip">
          {days.map((d) => (
            <div class:list={['cal__cell', { 'is-today': d.isToday, 'has-event': d.hasEvent }]}>
              <span class="cal__wd">{tt.weekdays[d.weekday]}</span>
              <span class="cal__day">{d.day}</span>
              <span class="cal__dot" aria-hidden="true"></span>
            </div>
          ))}
        </div>
      </div>

      {upcoming.length > 0 ? (
        <ul class="agenda" data-reveal-stagger>
          {upcoming.map((a) => (
            <li class="agenda__row">
              <span class="agenda__date mono">{spanLabel(a, lang)}</span>
              <span class="agenda__type mono">{tt.types[a.type as keyof typeof tt.types]}</span>
              <span class="agenda__title">{loc(a.title)}</span>
              <span class="agenda__by mono">{a.by}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="agenda__empty">{tt.monthEmpty}</p>
      )}
    </div>
  </section>

  <!-- WORKSHOPS -->
  <section class="esec">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">02</span><span class="sechead__label">{tt.workshopsLabel}</span>
      </div>
      <h2 class="esec__title caret-type" data-reveal>{tt.workshopsTitle}</h2>
      <p class="esec__sub" data-reveal>{tt.workshopsSub}</p>

      <div class="vgrid" data-reveal-stagger>
        {workshops.map((v) => (
          <article class="vcard" aria-label={a11y.membersOnly.replace("{title}", loc(v.title))}>
            <div class="vcard__screen">
              <img class="vcard__thumb" src={v.thumb} alt="" loading="lazy" />
              <span class="vcard__scan" aria-hidden="true"></span>
              <span class="vcard__play" aria-hidden="true"></span>
              <span class="vcard__dur mono">{v.duration}</span>
              <span class="vcard__badge mono">{tt.workshopsLabel}</span>
            </div>
            <p class="vcard__date mono">{v.date}</p>
            <h3 class="vcard__title">{loc(v.title)}</h3>
            {v.desc && <p class="vcard__desc">{loc(v.desc)}</p>}
            <div class="vcard__tags">{v.tags.map((t) => <span class="vtag mono">{t}</span>)}</div>
            <span class="vcard__watch mono"><span class="lock" aria-hidden="true"></span>{tt.watchNote}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- EVENTS -->
  <section class="esec">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">03</span><span class="sechead__label">{tt.eventsLabel}</span>
      </div>
      <h2 class="esec__title caret-type" data-reveal>{tt.eventsTitle}</h2>
      <p class="esec__sub" data-reveal>{tt.eventsSub}</p>

      <div class="vgrid" data-reveal-stagger>
        {events.map((v) => (
          <article class="vcard" aria-label={a11y.membersOnly.replace("{title}", loc(v.title))}>
            <div class="vcard__screen">
              <img class="vcard__thumb" src={v.thumb} alt="" loading="lazy" />
              <span class="vcard__scan" aria-hidden="true"></span>
              <span class="vcard__play" aria-hidden="true"></span>
              <span class="vcard__dur mono">{v.duration}</span>
              <span class="vcard__badge mono">{tt.eventsLabel}</span>
            </div>
            <p class="vcard__date mono">{v.date}</p>
            <h3 class="vcard__title">{loc(v.title)}</h3>
            {v.desc && <p class="vcard__desc">{loc(v.desc)}</p>}
            <div class="vcard__tags">{v.tags.map((t) => <span class="vtag mono">{t}</span>)}</div>
            <span class="vcard__watch mono"><span class="lock" aria-hidden="true"></span>{tt.watchNote}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HACKATHONS -->
  <section class="esec esec--hack">
    <div class="container">
      <div class="sechead" data-reveal>
        <span class="sechead__n">04</span><span class="sechead__label">{tt.hackathonsLabel}</span>
      </div>
      <h2 class="esec__title caret-type" data-reveal>{tt.hackathonsTitle}</h2>
      <p class="esec__sub" data-reveal>{tt.hackathonsSub}</p>

      <article class="hack" data-reveal aria-label={a11y.membersOnly.replace('{title}', `${hack.n} ${loc(hack.title)}`)}>
        <div class="hack__screen">
          <img class="vcard__thumb" src={hack.thumb} alt="" loading="lazy" />
          <span class="vcard__scan" aria-hidden="true"></span>
          <span class="vcard__play" aria-hidden="true"></span>
          <span class="vcard__dur mono">{hack.duration}</span>
          <span class="vcard__badge mono">{tt.hackathonsLabel}</span>
        </div>
        <span class="hack__badge mono">{tt.hackathonsLabel}</span>
        <h3 class="hack__title">{hack.n} {loc(hack.title)}</h3>
        <p class="hack__blurb">{tt.hackathon.blurb}</p>
        <p class="hack__when mono"><span class="hack__cal" aria-hidden="true"></span>{tt.hackathon.when}</p>
        <p class="hack__allowed mono">{tt.hackathon.allowed}</p>
        <div class="hack__status">
          <span class="hack__status-t mono">{tt.hackathon.statusLabel}</span>
          <p class="hack__status-b">{tt.hackathon.statusBody}</p>
        </div>
      </article>
    </div>
  </section>
</NanPage>

<style>
  /* ---------- HERO ---------- */
  .ehero { padding-block: clamp(32px, 5vh, 72px) clamp(48px, 7vh, 100px); }
  .ehero__title {
    margin-top: var(--space-4); font-family: var(--font-serif); max-width: 14ch;
    color: var(--color-text); line-height: 0.96; letter-spacing: -0.02em;
  }
  .ehero__sub {
    margin-top: var(--space-6); max-width: 52ch; color: var(--color-text);
    font-family: var(--font-serif); font-size: clamp(18px, 1.5vw, 22px); line-height: 1.5;
  }

  .lock {
    display: inline-block; width: 9px; height: 8px; position: relative; margin-right: 3px;
    border: 1.5px solid currentColor; border-top: 0; vertical-align: middle;
  }
  .lock::before {
    content: ''; position: absolute; left: 50%; top: -6px; width: 6px; height: 6px;
    transform: translateX(-50%); border: 1.5px solid currentColor; border-bottom: 0; border-radius: 3px 3px 0 0;
  }

  /* ---------- THIS MONTH (calendario bloqueado) ---------- */
  .emonth { padding-block: clamp(48px, 7vh, 100px); }
  .emonth__title {
    font-family: var(--font-serif); font-weight: 400; color: var(--color-text);
    font-size: clamp(34px, 4.4vw, 64px); line-height: 1.0; letter-spacing: -0.01em;
  }
  .emonth__sub {
    margin-top: var(--space-5); max-width: 52ch; color: var(--color-text);
    font-size: clamp(16px, 1.15vw, 18px); line-height: 1.6;
  }
  .cal {
    position: relative; margin-top: var(--space-8);
    border: 1px solid var(--color-line); overflow: hidden;
  }
  /* 30 celdas de 68px = 2040px: en móvil se corta. Un degradado en el borde
     derecho avisa de que la tira sigue, y el scroll queda con snap. */
  .cal::after {
    content: ''; position: absolute; top: 1px; right: 0; bottom: 1px; width: 56px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--color-bg));
  }
  .cal__strip {
    display: flex; gap: 0; overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
  }
  .cal__cell { scroll-snap-align: start; }
  .cal__cell {
    flex: 0 0 auto; width: 68px; height: 84px; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 6px;
    border-right: 1px solid var(--color-line);
  }
  .cal__wd { font-family: var(--font-mono); font-size: 11px; color: var(--color-muted); text-transform: uppercase; }
  .cal__day { font-family: var(--font-serif); font-size: 26px; color: var(--color-text); }
  .cal__cell { position: relative; }
  .cal__cell.is-today .cal__day { color: var(--color-violet-2); }
  .cal__cell.is-today { background: var(--color-violet-dim); }
  .cal__dot {
    width: 6px; height: 6px; border-radius: 50%; background: transparent;
    transition: transform var(--dur-ui) var(--ease);
  }
  .cal__cell.has-event { background: var(--color-violet-dim); }
  .cal__cell.has-event .cal__day { color: var(--color-violet-2); font-weight: 700; }
  .cal__cell.has-event .cal__dot { background: var(--color-violet); }

  /* agenda: lo que hay en los próximos 30 días (legible cuando hay algo) */
  .agenda { list-style: none; margin: var(--space-6) 0 0; padding: 0; border-top: 1px solid var(--color-line); }
  .agenda__row {
    display: grid; grid-template-columns: 92px 108px 1fr auto; align-items: baseline;
    gap: var(--space-4); padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-line);
    transition: background var(--dur-micro) var(--ease);
  }
  .agenda__row:hover { background: color-mix(in srgb, var(--color-violet) 7%, transparent); }
  .agenda__date { font-size: 13px; color: var(--color-violet-2); letter-spacing: 0.02em; }
  .agenda__type {
    font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: #fff;
    background: var(--color-violet); padding: 3px 8px; justify-self: start; align-self: center;
  }
  .agenda__title { font-family: var(--font-serif); font-size: clamp(17px, 1.5vw, 21px); color: var(--color-text); line-height: 1.2; }
  .agenda__by { font-size: 13px; color: var(--color-muted); }
  .agenda__empty { margin-top: var(--space-6); color: var(--color-muted); font-family: var(--font-serif); font-size: 17px; }

  @media (max-width: 620px) {
    .agenda__row { grid-template-columns: 1fr auto; gap: var(--space-2) var(--space-3); }
    .agenda__type { grid-column: 2; grid-row: 1; }
    .agenda__date { grid-column: 1; grid-row: 1; }
    .agenda__title { grid-column: 1 / -1; grid-row: 2; }
    .agenda__by { grid-column: 1 / -1; grid-row: 3; }
  }

  /* ---------- SECCIONES (workshops/events/hackathons) ---------- */
  .esec { padding-block: clamp(48px, 7vh, 100px); }
  .esec__title {
    font-family: var(--font-serif); font-weight: 400; color: var(--color-text);
    font-size: clamp(34px, 4.4vw, 64px); line-height: 1.0; letter-spacing: -0.01em;
  }
  .esec__sub {
    margin-top: var(--space-5); max-width: 54ch; color: var(--color-text);
    font-size: clamp(16px, 1.15vw, 18px); line-height: 1.6;
  }

  .vgrid {
    margin-top: var(--space-10); display: grid;
    grid-template-columns: repeat(3, 1fr); gap: var(--space-8) var(--space-6);
  }

  /* tarjeta NO clicable: solo hover con movimiento, sin enlace */
  .vcard { cursor: default; transition: transform var(--dur-ui) var(--ease); }
  .vcard:hover { transform: translateY(-6px); }

  .vcard__screen {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden;
    background:
      radial-gradient(120% 140% at 50% 0%, rgba(125,57,235,0.22), transparent 60%),
      var(--color-surface);
    border: 1px solid var(--color-line);
    transition: border-color var(--dur-ui) var(--ease);
  }
  .vcard:hover .vcard__screen { border-color: color-mix(in srgb, var(--color-violet) 55%, transparent); }
  .vcard__thumb {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: brightness(0.82) contrast(1.02);
    transition: filter var(--dur-ui) var(--ease), transform var(--dur-ui) var(--ease);
  }
  .vcard:hover .vcard__thumb,
  .hack:hover .vcard__thumb { filter: brightness(0.95); transform: scale(1.03); }
  .vcard__scan {
    position: absolute; inset: 0; opacity: 0.5;
    background: repeating-linear-gradient(0deg, rgba(255,255,255,0.05) 0 1px, transparent 1px 3px);
    transition: transform 0.2s var(--ease);
  }
  .vcard:hover .vcard__scan { transform: translateY(2px); }
  .vcard__play {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 0; height: 0; border-left: 20px solid var(--color-violet-2);
    border-top: 12px solid transparent; border-bottom: 12px solid transparent;
    filter: drop-shadow(0 0 12px rgba(125,57,235,0.5));
    transition: transform var(--dur-ui) var(--ease);
  }
  .vcard:hover .vcard__play { transform: translate(-50%, -50%) scale(1.12); }
  .vcard__dur {
    position: absolute; right: 8px; bottom: 8px; font-size: 12px; color: #fff;
    background: rgba(0,0,0,0.7); padding: 2px 6px;
  }
  .vcard__badge {
    position: absolute; left: 8px; top: 8px; font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; color: #fff; background: var(--color-violet); padding: 3px 7px;
  }
  .vcard__date { margin-top: var(--space-4); font-size: 12px; color: var(--color-muted); letter-spacing: 0.04em; }
  .vcard__title {
    margin-top: var(--space-2); font-family: var(--font-serif); font-weight: 400;
    color: var(--color-text); font-size: clamp(20px, 1.8vw, 26px); line-height: 1.1;
  }
  .vcard__desc {
    margin-top: var(--space-3); color: var(--color-muted);
    font-size: 15px; line-height: 1.55;
  }
  .vcard__tags { margin-top: var(--space-3); display: flex; flex-wrap: wrap; gap: 6px; }
  .vtag {
    font-size: 11px; color: var(--color-muted); border: 1px solid var(--color-line);
    padding: 2px 7px; letter-spacing: 0.02em;
  }
  .vcard__watch {
    margin-top: var(--space-4); display: inline-flex; align-items: center; gap: 4px;
    font-size: 12px; color: var(--color-muted); opacity: 0; transform: translateY(4px);
    transition: opacity var(--dur-ui) var(--ease), transform var(--dur-ui) var(--ease);
  }
  .vcard:hover .vcard__watch { opacity: 1; transform: translateY(0); color: var(--color-violet-2); }

  /* ---------- HACKATHON (destacado, tipo la referencia) ---------- */
  .hack {
    margin-top: var(--space-10); max-width: 760px; cursor: default;
    border: 1px solid var(--color-line); padding: clamp(24px, 3vw, 44px);
    transition: border-color var(--dur-ui) var(--ease), transform var(--dur-ui) var(--ease);
  }
  .hack:hover { border-color: color-mix(in srgb, var(--color-violet) 55%, transparent); transform: translateY(-4px); }
  .hack__screen {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden;
    border: 1px solid var(--color-line); margin-bottom: var(--space-6);
  }
  .hack__badge {
    display: inline-block; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-violet-2);
  }
  .hack__title {
    margin-top: var(--space-3); font-family: var(--font-mono); font-weight: 700;
    color: var(--color-text); font-size: clamp(28px, 3.4vw, 44px); line-height: 1.05; letter-spacing: -0.01em;
  }
  .hack__blurb {
    margin-top: var(--space-5); color: var(--color-text);
    font-size: clamp(17px, 1.3vw, 20px); line-height: 1.5; max-width: 52ch;
  }
  .hack__when {
    display: inline-flex; align-items: center; gap: 8px; margin-top: var(--space-6);
    font-size: 13px; color: var(--color-violet-2);
    border: 1px solid color-mix(in srgb, var(--color-violet) 45%, transparent);
    background: var(--color-violet-dim); padding: 8px 12px;
  }
  .hack__cal { display: inline-block; width: 12px; height: 12px; border: 1.5px solid currentColor; }
  .hack__allowed { margin-top: var(--space-5); font-size: 13px; line-height: 1.6; color: var(--color-muted); max-width: 60ch; }
  .hack__status { margin-top: var(--space-8); border: 1px solid var(--color-line); padding: var(--space-6); }
  .hack__status-t { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); }
  .hack__status-b { margin-top: var(--space-3); color: var(--color-text); font-size: 16px; line-height: 1.6; }

  @media (max-width: 900px) {
    .vgrid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .vgrid { grid-template-columns: 1fr; }
  }
</style>
