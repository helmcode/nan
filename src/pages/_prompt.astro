---
/**
 * Prompt engineering challenge: a three-step form with no login.
 *
 * Shared body of `/prompt` and `/es/prompt`. The answers go to the events
 * backend (POST /api/events/prompt-challenge, through the /api/events/*
 * proxy), which limits by IP and keeps one answer per IP. The behaviour lives
 * in scripts/promptChallenge.ts.
 *
 * Shared by link for a campaign, not search content: noindex and left out of
 * the sitemap, like /survey.
 *
 * Only the form: NanBase without nav or footer, and without the system
 * headline scale (`scale={false}`), whose 96px uppercase H1 overflowed the
 * screen with a question this long. The card sits in the middle of the
 * viewport.
 */
import NanBase from '../layouts/NanBase.astro';
// Brush handwriting for the answer's last words; self-hosted like the rest
// of the fonts (CSP font-src 'self') and loaded only on this page.
import '@fontsource/caveat-brush/latin-400.css';
import { getLang, useT } from '../lib/i18n';

const lang = getLang(Astro.url);
const tt = useT(lang).prompt;
const step = (n: number) => tt.stepLabel.replace('{n}', String(n));
---

<NanBase title={tt.metaTitle} description={tt.metaDesc} noindex nofollow scale={false}>
  <section
    class="pc"
    data-prompt-challenge
    data-lang={lang}
    data-sending={tt.question.sending}
    data-messages={JSON.stringify(tt.errors)}>
      <div class="pc__wrap">
        <div class="pc__step" data-step="1">
          <p class="eyebrow">{tt.kicker}</p>
          <p class="pc__count">{step(1)}</p>
          <h1 class="pc__title" tabindex="-1" data-step-title>{tt.intro.title}</h1>
          <button class="btn btn-primary pc__cta" type="button" data-prompt-start>{tt.intro.cta}</button>
        </div>

        <div class="pc__step" data-step="2" hidden>
          <p class="eyebrow">{tt.kicker}</p>
          <p class="pc__count">{step(2)}</p>
          <h2 class="pc__title" tabindex="-1" data-step-title>{tt.question.title}</h2>
          <form class="pc__form" data-prompt-form novalidate>
            <label class="pc__label" for="pc-prompt">{tt.question.promptLabel}</label>
            <textarea
              class="field pc__textarea"
              id="pc-prompt"
              name="prompt"
              rows="8"
              minlength="10"
              maxlength="2000"
              required
              aria-describedby="pc-prompt-hint"
              placeholder={tt.question.promptPlaceholder}></textarea>
            <p class="pc__hint" id="pc-prompt-hint">{tt.question.promptHint}</p>

            <label class="pc__label" for="pc-twitter">{tt.question.twitterLabel}</label>
            <input
              class="field pc__input"
              id="pc-twitter"
              name="twitter"
              type="text"
              maxlength="16"
              autocomplete="off"
              spellcheck="false"
              placeholder={tt.question.twitterPlaceholder} />

            {/* Honeypot: hidden from people and assistive tech, filled in by bots. */}
            <div class="pc__trap" aria-hidden="true">
              <label for="pc-website">Website</label>
              <input id="pc-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <p class="pc__error" role="alert" tabindex="-1" data-prompt-error hidden></p>
            <button class="btn btn-primary pc__cta" type="submit">{tt.question.submit}</button>
          </form>
        </div>

        {/* Between steps 2 and 3: a reasoning-model style "Thinking" screen
            shown while the answer is sent (at least two seconds). */}
        <div class="pc__step pc__thinking" data-step="thinking" hidden>
          <img class="pc__logo" src="/nan-logo.png" alt="" width="72" height="72" />
          <p class="pc__think-label" role="status" tabindex="-1" data-step-title>
            <span class="pc__shimmer">{tt.thinking}</span><span class="pc__dots" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span>
          </p>
        </div>

        {/* Only the model's "answer", on the bare background, written out token
            by token. Screen readers get the whole text at once from the hidden
            copy; the streamed one is decoration. An invisible ghost copy holds
            the final height so the centered text does not creep up as it grows.
            The last words are then "written by hand" in brush ink. */}
        <div class="pc__step" data-step="3" hidden>
          <p class="pc__answer" tabindex="-1" data-step-title data-answer={tt.done.answer}>
            <span class="pc__sr" data-answer-sr>{tt.done.answer} {tt.done.handwritten}</span>
            <span class="pc__ghost" aria-hidden="true" data-answer-ghost>{tt.done.answer} <span class="pc__hand">{tt.done.handwritten}</span></span>
            <span class="pc__out" aria-hidden="true"><span data-answer-out></span><span class="pc__caret" data-answer-caret hidden></span> <span class="pc__hand" data-answer-hand hidden>{tt.done.handwritten}</span></span>
          </p>
        </div>
      </div>
  </section>
</NanBase>

<style>
  .pc {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 24px 16px;
  }
  .pc__wrap {
    width: 100%;
    max-width: 640px;
  }
  .pc__step {
    margin-top: var(--space-3);
  }
  .pc__count {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .pc__title {
    margin-top: var(--space-3);
    font-size: clamp(22px, 3.2vw, 30px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: normal;
    text-transform: none;
    overflow-wrap: anywhere;
    color: var(--color-text);
  }
  .pc__title:focus {
    outline: none;
  }
  .pc__lead {
    margin-top: var(--space-4);
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-body);
  }
  .pc__cta {
    margin-top: 32px;
  }
  .pc__form {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
  }
  .pc__label {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text);
  }
  .pc__label:first-child {
    margin-top: 0;
  }
  .pc__textarea {
    width: 100%;
    height: auto;
    min-height: 200px;
    padding: 14px 16px;
    font-size: 16px;
    line-height: 1.5;
    resize: vertical;
  }
  .pc__input {
    width: 100%;
    max-width: 320px;
  }
  .pc__hint {
    margin-top: var(--space-2);
    font-size: 13px;
    color: var(--color-muted);
  }
  .pc__error {
    margin-top: var(--space-5);
    padding: 12px 16px;
    border: 1px solid var(--color-violet);
    color: var(--color-text);
    font-size: 14.5px;
  }
  .pc__form .pc__cta {
    align-self: flex-start;
  }
  .pc__form .pc__cta:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .pc__thinking {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    padding: 48px 0;
  }
  .pc__thinking[hidden] {
    display: none;
  }
  .pc__logo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    animation: pc-pulse 1.4s ease-in-out infinite;
  }
  .pc__think-label {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--color-muted);
  }
  .pc__think-label:focus {
    outline: none;
  }
  /* The light sweep across the word, like the "Thinking" label of reasoning models. */
  .pc__shimmer {
    background: linear-gradient(90deg, var(--color-muted) 0%, var(--color-text) 50%, var(--color-muted) 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: pc-shimmer 1.6s linear infinite;
  }
  .pc__dots span {
    animation: pc-dot 1.2s infinite;
  }
  .pc__dots span:nth-child(2) {
    animation-delay: 0.2s;
  }
  .pc__dots span:nth-child(3) {
    animation-delay: 0.4s;
  }
  .pc__answer {
    display: grid;
    font-size: clamp(19px, 2.4vw, 23px);
    line-height: 1.6;
    color: var(--color-text);
  }
  .pc__answer:focus {
    outline: none;
  }
  .pc__ghost,
  .pc__out {
    grid-area: 1 / 1;
  }
  .pc__ghost {
    visibility: hidden;
  }
  /* The answer carries blank lines (\n\n) for a dramatic pause. */
  .pc__ghost,
  .pc__out {
    white-space: pre-line;
  }
  .pc__hand {
    display: inline-block;
    margin-left: 0.1em;
    font-family: 'Caveat Brush', cursive;
    font-size: 1.75em;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-text);
    transform: rotate(-4deg);
    transform-origin: left bottom;
  }
  .pc__hand[hidden] {
    display: none;
  }
  /* Ink laid down left to right, like a pen stroke, with a small overshoot
     margin so the brush swashes are not clipped. */
  .pc__hand.is-writing {
    animation: pc-write 1.6s cubic-bezier(0.55, 0.1, 0.35, 1) both;
  }
  @keyframes pc-write {
    from {
      clip-path: inset(-0.4em 100% -0.4em -0.2em);
    }
    to {
      clip-path: inset(-0.4em -0.2em -0.4em -0.2em);
    }
  }
  /* The blinking block a chat UI shows at the end of a reply that is still streaming. */
  .pc__caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--color-violet);
    animation: pc-blink 1s steps(1) infinite;
  }
  .pc__caret[hidden] {
    display: none;
  }
  .pc__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @keyframes pc-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes pc-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
      filter: drop-shadow(0 0 0 transparent);
    }
    50% {
      transform: scale(1.12);
      opacity: 0.75;
      filter: drop-shadow(0 0 18px var(--color-violet));
    }
  }
  @keyframes pc-shimmer {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: -100% 0;
    }
  }
  @keyframes pc-dot {
    0%,
    100% {
      opacity: 0.2;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pc__logo,
    .pc__caret,
    .pc__hand.is-writing,
    .pc__shimmer,
    .pc__dots span {
      animation: none;
    }
    .pc__shimmer {
      color: var(--color-muted);
    }
  }
  /* Off-screen rather than display:none: some bots skip fields that are not rendered. */
  .pc__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  import { initPromptChallenge } from '../scripts/promptChallenge';
  initPromptChallenge();
</script>
