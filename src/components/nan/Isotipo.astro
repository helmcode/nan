---
/**
 * Isotipo NaN — geometría canónica de docs/brand/nan-brandbook.md §2.
 * Trazo plano (v2): `variant="violet"` (por defecto) o `variant="white"`
 * (inversa, sobre violeta o foto ditherizada). Sin degradado: eliminado del sistema.
 */
interface Props {
  size?: number;
  variant?: 'violet' | 'white';
  class?: string;
}
const { size = 32, variant = 'violet', class: className } = Astro.props;
const stroke = variant === 'white' ? '#FFFFFF' : 'var(--color-violet)';
---

<svg
  viewBox="-130 -145 260 290"
  width={size}
  height={size * (290 / 260)}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class={className}
>
  <g stroke={stroke} fill="none" stroke-width="9" stroke-linecap="round" stroke-linejoin="round">
    <path d="M0,-130 L112.6,-65 L112.6,65 L0,130 L-112.6,65 L-112.6,-65 Z" />
    <path d="M-38.9,-30.6 L38.9,30.6 A39,39 0 1 0 38.9,-30.6" />
    <path d="M38.9,-30.6 L-38.9,30.6 A39,39 0 1 1 -38.9,-30.6" />
  </g>
</svg>
