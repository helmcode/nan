---
/**
 * Eyebrow de NaN: etiqueta corta en Archivo, versalitas, con una marca de píxel
 * sólida delante (un cuadrado violeta — el píxel, no un sprite animado).
 * `light` para superficies claras. `center` para secciones centradas.
 */
interface Props {
  label: string;
  light?: boolean;
  center?: boolean;
  class?: string;
}
const { label, light = false, center = false, class: className } = Astro.props;
---

<p class:list={['eyebrow-mark', { light, center }, className]}>
  <span class="eyebrow-mark__px" aria-hidden="true"></span>
  <span>{label}</span>
</p>

<style>
  .eyebrow-mark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }
  .eyebrow-mark.center { display: flex; justify-content: center; }
  .eyebrow-mark.light { color: var(--color-snow-dim); }
  .eyebrow-mark__px {
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    background: var(--color-violet);
  }
</style>
