---
// "Helmcode Desktop" — three download cards (macOS / Windows / Linux). Every
// link is a one-click stable URL to the asset of the latest GitHub release
// (see lib/desktop), so it works with zero JS. PlatformHighlight is
// progressive enhancement only: it highlights the card for the visitor's OS.
import { getLang, useT, withLang } from '../../../lib/i18n';
import { DESKTOP_PLATFORMS, buildsFor, desktopAssetUrl, fileExt } from '../../../lib/desktop';
import PlatformHighlight from '../desktop/PlatformHighlight.astro';

const lang = getLang(Astro.url);
const tt = useT(lang).download;
---

<section class="download" id="download">
  <div class="container">
    <div class="sechead" data-reveal>
      <span class="sechead__n">02</span><span class="sechead__label">{tt.label}</span>
    </div>
    <h2 class="download__title caret-type" data-reveal>{tt.title1}<br /><span class="hl">{tt.title2}</span></h2>
    <p class="download__sub" data-reveal>{tt.sub}</p>

    <ul class="download__grid" data-reveal-stagger data-download-grid>
      {DESKTOP_PLATFORMS.map((os) => {
        const p = tt.platforms[os];
        const builds = buildsFor(os);
        return (
          <li class="dcard" data-platform={os}>
            <span class="dcard__top">
              <span class="dcard__name">{p.name}</span>
              <span class="dcard__tag" data-detected-tag hidden>{tt.detected}</span>
            </span>
            <span class="dcard__formats">{p.formats}</span>
            <span class="dcard__links">
              {builds.map((b) => (
                <a class="dcard__cta" href={desktopAssetUrl(b.file)} rel="noopener">
                  {builds.length > 1 ? `${tt.cta} · ${tt.arch[b.id]}` : `${tt.cta} ${fileExt(b.file)}`}{' '}
                  <span aria-hidden="true">↓</span>
                </a>
              ))}
            </span>
            {builds.flatMap((b) => b.alternates).length > 0 && (
              <span class="dcard__alt">
                {tt.also}{' '}
                {builds.flatMap((b) => b.alternates).map((file, i) => (
                  <>{i > 0 && ' · '}<a href={desktopAssetUrl(file)} rel="noopener">{fileExt(file)}</a></>
                ))}
              </span>
            )}
          </li>
        );
      })}
    </ul>

    <p class="download__req" data-reveal>
      {tt.requirements}{' '}
      <a href={withLang('/download', lang)}>{tt.allOptions} →</a>
    </p>
  </div>
</section>

<PlatformHighlight />

<style>
  .download { padding-block: clamp(64px, 9vh, 130px); }

  .download__title {
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--color-text);
    font-size: clamp(40px, 5vw, 76px);
    line-height: 1.0;
    letter-spacing: -0.01em;
  }
  .download__sub {
    margin-top: var(--space-8);
    max-width: 56ch;
    color: var(--color-text);
    font-size: clamp(16px, 1.15vw, 18px);
    line-height: 1.7;
  }

  .download__grid {
    list-style: none;
    margin: var(--space-12) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .dcard {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    padding: 22px 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: var(--color-text);
    transition: border-color var(--dur-micro) var(--ease);
  }
  .dcard:hover, .dcard:focus-within { border-color: var(--color-violet); }
  .dcard[data-detected] { border-color: var(--color-violet); background: var(--color-violet-dim); }

  .dcard__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .dcard__name {
    font-family: var(--font-serif);
    font-size: clamp(26px, 2.2vw, 34px);
    line-height: 1.1;
  }
  .dcard__tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-violet-2);
  }
  .dcard__tag[hidden] { display: none; }
  .dcard__formats {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-muted);
  }
  .dcard__links {
    margin-top: auto;
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .dcard__cta {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-violet-2);
    text-decoration: none;
  }
  .dcard__cta:hover, .dcard__cta:focus-visible { color: var(--color-text); text-decoration: underline; }
  .dcard__alt {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-muted);
  }
  .dcard__alt a { color: var(--color-muted); }
  .dcard__alt a:hover, .dcard__alt a:focus-visible { color: var(--color-violet-2); }

  .download__req {
    margin-top: var(--space-8);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
  }
  .download__req a { color: var(--color-violet-2); }

  @media (max-width: 860px) {
    .download { padding-block: var(--space-16); }
    .download__grid { grid-template-columns: 1fr; }
  }
</style>
