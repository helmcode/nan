---
import { getLang, useT } from '../../../lib/i18n';

const tt = useT(getLang(Astro.url)).privacy;
---

<section class="privacy" id="privacy">
  <div class="container">
    <div class="sechead" data-reveal>
      <span class="sechead__n">04</span><span class="sechead__label">{tt.label}</span>
    </div>
    <h2 class="privacy__title caret-type" data-reveal>{tt.title1}<br /><span class="hl">{tt.title2}</span></h2>
    <div class="privacy__grid" data-reveal>
    <div class="privacy__lead">
      <p class="privacy__intro">{tt.intro}</p>

      <ul class="guarantees">
        {tt.guarantees.map((g) => <li>{g}</li>)}
      </ul>
    </div>

    <div class="term" aria-hidden="true">
      <div class="term__bar">
        <span class="term__sq"></span>
        <span class="term__path">~/nan/logs</span>
      </div>
      <div class="term__body">
        <p><span class="term__p">$</span> cat prompts.log</p>
        <p><span class="term__p">$</span> cat responses.log</p>
        <p><span class="term__p">$</span> cat your_code.log</p>
        <p class="term__note">{tt.termNote}</p>
        <p><span class="term__p">$</span> <span class="term__cursor">_</span></p>
      </div>
      <div class="term__foot">{tt.termFoot}</div>
    </div>
    </div>
  </div>
</section>

<style>
  .privacy { padding-block: clamp(64px, 9vh, 130px); }
  .privacy__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: start;
    margin-top: var(--space-10);
  }

  .privacy__title {
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--color-text);
    font-size: clamp(40px, 5vw, 76px);
    line-height: 1.0;
    letter-spacing: -0.01em;
  }
  .privacy__intro {
    margin-top: 0;
    max-width: 52ch;
    color: var(--color-text);
    font-size: clamp(16px, 1.15vw, 18px);
    line-height: 1.7;
  }

  .guarantees {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .guarantees li {
    position: relative;
    padding-left: 28px;
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.5;
    color: var(--color-text);
  }
  .guarantees li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-violet);
  }

  /* terminal: la prueba visual del zero-logs */
  .term {
    font-family: var(--font-mono);
    font-size: 14.5px;
    line-height: 1.55;
    background: #08070a;
    border: 1px solid var(--color-line);
  }
  .term p { font-family: var(--font-mono); color: inherit; }
  .term__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--color-hairline);
  }
  .term__sq { width: 8px; height: 8px; background: var(--color-violet); flex: 0 0 auto; }
  .term__path { font-size: 13px; color: var(--color-muted); letter-spacing: 0.02em; }
  .term__body {
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 11px;
    color: var(--color-body);
  }
  .term__p { color: var(--color-violet-2); margin-right: 8px; }
  .term__note { color: var(--color-violet-2); }
  .term__cursor { color: var(--color-violet-2); animation: term-blink 1.05s steps(1) infinite; }
  @keyframes term-blink { 50% { opacity: 0; } }
  .term__foot {
    padding: 11px 16px;
    border-top: 1px solid var(--color-hairline);
    font-size: 11.5px;
    color: var(--color-text-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .term__cursor { animation: none; }
  }
  @media (max-width: 860px) {
    .privacy { padding-block: var(--space-16); }
    .privacy__grid { grid-template-columns: 1fr; gap: var(--space-10); }
  }
</style>
