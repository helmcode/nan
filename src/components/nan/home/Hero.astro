---
// Hero del sistema definitivo. Ilustración dithered en canvas (blanco->violeta
// al hover), glitch en el H1 y el formulario de alta (data-signup), cableado
// por scripts/signup.ts con la validación compartida de lib/signup.ts.
import { getLang, useT } from '../../../lib/i18n';
import { JOB_ROLES } from '../../../lib/signup';

const lang = getLang(Astro.url);
const tt = useT(lang).hero;
const p = (path: string) => (lang === 'es' ? `/es${path}` : path);

// Las capas de glitch del H1 son pseudoelementos, así que su texto tiene que
// viajar por CSS. Se lo pasamos como custom property para que siga al idioma
// (antes iba hardcodeado en inglés y se veía sobre el titular español).
const glitchText = `'${`${tt.line1}\\A ${tt.line2}`.replace(/'/g, "\\'")}'`;

// Mensajes de estado del formulario: los lee scripts/signup.ts desde el <form>.
const signupMsgs = JSON.stringify({
  sending: tt.sending,
  okTitle: tt.okTitle,
  okText: tt.okText,
  errFullName: tt.errFullName,
  errEmail: tt.errEmail,
  errJobRole: tt.errJobRole,
  errJobRoleOther: tt.errJobRoleOther,
  errXUrl: tt.errXUrl,
  errLinkedinUrl: tt.errLinkedinUrl,
  errFields: tt.errFields,
  errRateLimited: tt.errRateLimited,
  errNetwork: tt.errNetwork,
  errGeneric: tt.errGeneric,
});
---

<header class="hero" id="signup">
  <canvas id="hero-fx" class="hero__fx" aria-hidden="true"></canvas>

  <div class="container hero__inner">
    <div class="hero__col">
      <h1 class="hero__title" style={`--glitch: ${glitchText}`}>
        {tt.line1}<br /><span class="hl">{tt.line2}</span>
      </h1>

      <p class="hero__sub">{tt.sub}</p>

      <p class="hero__body">{tt.body}</p>

      <p class="hero__lead">
        <span class="spots"><span class="spots__dot" aria-hidden="true"></span>{tt.spots}</span>
        {tt.signupLine}
      </p>

      <form class="hero__form signup" method="post" action="/api/signup" data-signup data-msgs={signupMsgs} novalidate>
        <label class="hero__hp" aria-hidden="true">
          Do not fill this field
          <input type="text" name="_hp" tabindex="-1" autocomplete="off" />
        </label>

        <div class="signup__grid">
          <div class="signup__row">
            <label class="signup__label" for="signup-fullName">{tt.labelFullName} <span class="signup__req" aria-hidden="true">*</span></label>
            <input
              class="field signup__input" id="signup-fullName" type="text" name="fullName" required
              maxlength="120" autocomplete="name" placeholder={tt.phFullName}
              aria-describedby="signup-fullName-err"
            />
            <span class="signup__err" id="signup-fullName-err" data-error="fullName"></span>
          </div>

          <div class="signup__row">
            <label class="signup__label" for="signup-email">{tt.labelEmail} <span class="signup__req" aria-hidden="true">*</span></label>
            <input
              class="field signup__input" id="signup-email" type="email" name="email" required
              maxlength="254" autocomplete="email" inputmode="email" spellcheck="false"
              placeholder={tt.phEmail} aria-describedby="signup-email-err"
            />
            <span class="signup__err" id="signup-email-err" data-error="email"></span>
          </div>

          <div class="signup__row">
            <label class="signup__label" for="signup-jobRole">{tt.labelJobRole} <span class="signup__req" aria-hidden="true">*</span></label>
            <select
              class="field signup__input signup__select" id="signup-jobRole" name="jobRole" required
              aria-describedby="signup-jobRole-err"
            >
              <option value="" selected disabled>{tt.jobRolePlaceholder}</option>
              {JOB_ROLES.map((role) => <option value={role}>{tt.jobRoles[role]}</option>)}
            </select>
            <span class="signup__err" id="signup-jobRole-err" data-error="jobRole"></span>
          </div>

          <div class="signup__row" data-other hidden>
            <label class="signup__label" for="signup-jobRoleOther">{tt.labelJobRoleOther} <span class="signup__req" aria-hidden="true">*</span></label>
            <input
              class="field signup__input" id="signup-jobRoleOther" type="text" name="jobRoleOther"
              maxlength="80" autocomplete="organization-title" placeholder={tt.phJobRoleOther}
              aria-describedby="signup-jobRoleOther-err"
            />
            <span class="signup__err" id="signup-jobRoleOther-err" data-error="jobRoleOther"></span>
          </div>

          <div class="signup__row">
            <label class="signup__label" for="signup-xUrl">{tt.labelXUrl} <span class="signup__opt">({tt.optional})</span></label>
            <input
              class="field signup__input" id="signup-xUrl" type="url" name="xUrl" maxlength="200"
              inputmode="url" spellcheck="false" autocomplete="url" placeholder={tt.phXUrl}
              aria-describedby="signup-xUrl-err"
            />
            <span class="signup__err" id="signup-xUrl-err" data-error="xUrl"></span>
          </div>

          <div class="signup__row">
            <label class="signup__label" for="signup-linkedinUrl">{tt.labelLinkedinUrl} <span class="signup__opt">({tt.optional})</span></label>
            <input
              class="field signup__input" id="signup-linkedinUrl" type="url" name="linkedinUrl" maxlength="200"
              inputmode="url" spellcheck="false" autocomplete="url" placeholder={tt.phLinkedinUrl}
              aria-describedby="signup-linkedinUrl-err"
            />
            <span class="signup__err" id="signup-linkedinUrl-err" data-error="linkedinUrl"></span>
          </div>
        </div>

        <div class="signup__actions">
          <button type="submit" class="btn btn-primary" data-submit>{tt.submit}</button>
          <p class="signup__legal">
            <span class="signup__req" aria-hidden="true">*</span> {tt.requiredNote} ·
            {tt.legalPre} <a href={p('/terms')}>{tt.legalTerms}</a> {tt.legalAnd} <a href={p('/privacy')}>{tt.legalPrivacy}</a>.
          </p>
        </div>

        <p class="hero__status" data-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    align-items: center;
    /* Aire garantizado arriba y abajo. `min-height` es un mínimo, así que si la
       columna no cabe la sección crece en vez de recortarla: sin este colchón,
       en un portátil de 13" el contenido llegaba justo al borde y el titular se
       pegaba al nav. */
    padding-block: clamp(20px, 4vh, 56px);
  }
  .hero__fx { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; pointer-events: none; }
  .hero__inner { position: relative; z-index: 2; }
  .hero__col { max-width: 720px; }

  /* Subida óptica de la composición, SOLO donde sobra alto.
     Iba en la regla base y era el bug de las pantallas de 13": el hero está en
     overflow:hidden, y cuando la columna mide casi lo mismo que el hero no hay
     holgura que absorber los 4vh, así que el titular se salía por arriba y se
     recortaba (medido: 28px a 1440x700, 26 a 1366x640, 14 a 1512x800) quedando
     además por debajo del nav. Con la columna en ~684px, el desplazamiento solo
     cabe a partir de unos 830px de viewport; 900 deja margen para que el copy
     crezca o cambie de idioma. */
  @media (min-height: 900px) {
    .hero__col { transform: translateY(-4vh); }
  }

  /* ---- H1 con glitch (aberración cromática violeta, ráfagas espaciadas) ---- */
  .hero__title {
    position: relative;
    font-family: var(--font-serif);
    font-weight: 400;
    white-space: nowrap;
    font-size: clamp(50px, 6.6vw, 104px);
    line-height: 0.96;
    letter-spacing: -0.01em;
    margin-bottom: 22px;
  }
  .hero__title::before, .hero__title::after {
    content: var(--glitch, '');
    white-space: pre;
    position: absolute; top: 0; left: 0;
    pointer-events: none;
  }
  .hero__title::before { color: var(--color-violet); animation: glitchA 9s infinite steps(2, end); }
  .hero__title::after { color: var(--color-text); opacity: 0.85; animation: glitchB 13s infinite steps(2, end); }
  @keyframes glitchA {
    0%, 7%, 100% { clip-path: inset(0 0 100% 0); transform: translate(0); }
    1% { clip-path: inset(14% 0 60% 0); transform: translate(-4px, -1px); }
    3% { clip-path: inset(56% 0 24% 0); transform: translate(4px, 1px); }
    5% { clip-path: inset(34% 0 46% 0); transform: translate(-3px, 0); }
  }
  @keyframes glitchB {
    0%, 6%, 100% { clip-path: inset(0 0 100% 0); transform: translate(0); }
    68% { clip-path: inset(70% 0 12% 0); transform: translate(4px, 1px); }
    74% { clip-path: inset(20% 0 60% 0); transform: translate(-4px, -1px); }
    80% { clip-path: inset(46% 0 34% 0); transform: translate(3px, 0); }
    86% { clip-path: inset(0 0 100% 0); transform: translate(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__title::before, .hero__title::after { display: none; }
  }

  .hero__sub {
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--color-text);
    font-size: clamp(21px, 2.4vw, 32px);
    line-height: 1.12;
    margin-bottom: 32px;
  }
  .hero__body {
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--color-text);
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.5;
    max-width: 660px;
    margin-bottom: 52px;
  }

  .hero__lead {
    display: flex; align-items: center; flex-wrap: wrap;
    font-family: var(--font-sans);
    color: var(--color-muted);
    font-size: 15px;
    margin-bottom: 22px;
  }
  .spots {
    display: inline-flex; align-items: center; gap: 9px;
    font-family: var(--font-sans);
    font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-text); white-space: nowrap; margin-right: 12px;
  }
  .spots__dot {
    width: 9px; height: 9px; background: var(--color-violet); border-radius: 50%;
    box-shadow: 0 0 0 0 var(--pulse); animation: spots-pulse 2.2s infinite;
  }
  @keyframes spots-pulse {
    0% { box-shadow: 0 0 0 0 var(--pulse); }
    70% { box-shadow: 0 0 0 12px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hero__form { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; width: 100%; max-width: 640px; }
  .hero__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  /* formulario de alta: rejilla de 2 columnas que pasa a 1 en móvil */
  .signup__grid { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
  .signup__row { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .signup__row[hidden] { display: none; }
  .signup__label {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  .signup__req { color: var(--color-violet-2); }
  .signup__opt { color: #6a6a6e; }
  .signup__input { width: 100%; min-width: 0; caret-color: var(--color-violet); }
  .signup__input[aria-invalid='true'] { border-color: #ff6b6b; }
  .signup__select {
    appearance: none; cursor: pointer; padding-right: 40px;
    background-image: linear-gradient(45deg, transparent 50%, var(--color-muted) 50%),
      linear-gradient(135deg, var(--color-muted) 50%, transparent 50%);
    background-position: calc(100% - 20px) 50%, calc(100% - 15px) 50%;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
  }
  .signup__select:invalid { color: #6a6a6e; }
  .signup__select option { background: var(--color-surface); color: var(--color-text); }
  .signup__err { min-height: 0; font-family: var(--font-mono); font-size: 12px; color: #ff8a8a; }
  .signup__err:empty { display: none; }
  .signup__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px 20px; }
  .signup__legal { max-width: 40ch; font-size: 12.5px; line-height: 1.5; color: var(--color-muted); }
  .signup__legal a { color: var(--color-link); text-decoration: underline; text-decoration-color: var(--color-link-line); }
  .signup[data-done='true'] .signup__grid,
  .signup[data-done='true'] .signup__actions { opacity: 0.45; }

  .hero__status {
    min-height: 1.2em; margin-top: 2px;
    font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.02em;
    color: var(--color-violet-2);
  }
  .hero__status[data-state='error'] { color: #ff8a8a; }
  .hero__status[data-state='ok'] { font-size: 14px; color: var(--color-text); }
  .hero__status[data-state='ok'] strong { color: var(--color-violet-2); font-weight: 600; }

  @media (max-width: 860px) {
    .hero__fx { opacity: 0.5; }
    .hero__col { transform: none; }
  }
  @media (max-width: 720px) {
    /* apilado, la ilustración queda DEBAJO del texto y se lo comía: al ser
       píxeles blancos sobre texto blanco había tramos ilegibles */
    .hero__fx { opacity: 0.22; }
    .hero { min-height: 0; padding-block: var(--space-12) var(--space-16); }
    .hero__title { white-space: normal; }
    .hero__title::before, .hero__title::after { display: none; }
    .signup__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { initHeroDither } from '../../../scripts/heroDither';
  initHeroDither('hero-fx');

</script>
