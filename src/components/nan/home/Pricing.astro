---
// Prices verified against nan.builders: Member 70€ · GLM 5.3 premium 200€ · Community 14,99€.
//
// There is no per-region tier and no per-region currency any more. Every new
// signup is charged in EUR from any region, on BOTH funnels: cloud-api's
// inferencePriceForNewCustomer and communityPriceForNewCustomer each always
// return the EU price. So the `nan_member · usa / latam — $75` tier was removed
// AND community is published in euros here, for the same reason: a prospect
// from outside the EU read a $ amount and landed on a EUR Checkout, a different
// price in a different currency, at the payment step. Legacy USD subscriptions
// still exist and keep their price; that is explained in the payment-methods
// FAQ entry, not here.
import { getLang, useT } from '../../../lib/i18n';

const lang = getLang(Astro.url);
const tt = useT(lang).pricing;
const home = lang === 'es' ? '/es' : '/';

const tiers = [
  // GLM 5.3 premium — price swap on the existing nan_member
  // subscription (200€/mo, EUR only). Shown first as the flagship tier.
  {
    name: 'nan_member · glm 5.3 premium',
    amount: '200€',
    per: tt.perVat,
    badge: tt.premiumBadge,
    ref: true,
    includes: tt.premiumIncludes,
    cond: tt.premiumCond,
    cta: tt.premiumCta,
    href: `${home}?premium=1#waitlist`,
    primary: true,
  },
  {
    name: 'nan_member',
    amount: '70€',
    per: tt.perVat,
    badge: tt.inferenceIncluded,
    ref: true,
    includes: tt.memberIncludes,
    cond: tt.memberCond,
    cta: tt.memberCta,
    href: `${home}#waitlist`,
    primary: true,
  },
  {
    name: 'nan_community',
    amount: '14,99€',
    per: tt.perTaxes,
    badge: null,
    ref: false,
    includes: tt.communityIncludes,
    cond: tt.communityCond,
    cta: tt.communityCta,
    href: lang === 'es' ? '/es/community#signup' : '/community#signup',
    primary: false,
  },
];

// Workspace slots, sold to any paying member (helmcode/nan workspaces launch).
// Sizes mirror cloud-api's tier catalogue (internal/workspace/tiers.go); the
// prices are the live EUR Stripe prices of the slot and of the backup add-on
// (cmd/stripe-bootstrap/workspace_backups.go). The premium plan's free
// workspace is the Micro size.
const workspaceSlots = [
  { size: 'micro', vcpu: 1, ram: 2, disk: 10, slot: '4,99€', backups: '0,99€' },
  { size: 'nano', vcpu: 2, ram: 4, disk: 20, slot: '8,99€', backups: '1,49€' },
  { size: 'basic', vcpu: 4, ram: 8, disk: 40, slot: '16,99€', backups: '2,49€' },
  { size: 'medium', vcpu: 8, ram: 16, disk: 80, slot: '32,99€', backups: '3,99€' },
  { size: 'large', vcpu: 8, ram: 32, disk: 160, slot: '60,99€', backups: '6,99€' },
];
const ws = tt.workspaces;
const wsDocs = lang === 'es' ? '/es/docs/workspaces' : '/docs/workspaces';
---

<section class="pricing" id="pricing">
  <div class="container">
    <div class="pricing__head" data-reveal>
      <div class="sechead">
        <span class="sechead__n">05</span><span class="sechead__label">{tt.label}</span>
      </div>
      <h2 class="pricing__title caret-type">{tt.title1}<br /><span class="hl">{tt.title2}</span></h2>
      <p class="pricing__sub">{tt.sub}</p>
    </div>

    <div class="pricing__grid" data-reveal-stagger>
      {tiers.map((tier) => (
        <article class:list={['ptier', { 'ptier--ref': tier.ref }]}>
          <div class="ptier__top">
            <span class="ptier__name">{tier.name}</span>
            {tier.badge
              ? <span class="ptier__badge">{tier.badge}</span>
              : <span class="ptier__badge ptier__badge--ghost" aria-hidden="true">{tt.inferenceIncluded}</span>}
          </div>

          <div class="ptier__price">
            <span class="ptier__amount" data-nan="NaN">{tier.amount}</span>
            <span class="ptier__per">{tier.per}</span>
          </div>

          <ul class="ptier__list">
            {tier.includes.map((item) => <li>{item}</li>)}
          </ul>

          <a
            class:list={['btn', 'ptier__cta', tier.primary ? 'btn-primary' : 'btn-ghost']}
            href={tier.href}
            rel={tier.href.startsWith('http') ? 'noopener' : undefined}
          >
            {tier.cta}
          </a>
          <p class="ptier__cond">{tier.cond}</p>
        </article>
      ))}
    </div>

    <div class="pws" id="workspaces" data-reveal>
      <div class="pws__head">
        <span class="pws__label">{ws.label}</span>
        <h3 class="pws__title">{ws.title}</h3>
        <p class="pws__sub">{ws.sub}</p>
      </div>

      <div class="pws__tablewrap">
        <table class="pws__table">
          <thead>
            <tr>
              <th scope="col">{ws.headSize}</th>
              <th scope="col">{ws.headSpecs}</th>
              <th scope="col">{ws.headSlot}</th>
              <th scope="col">{ws.headBackups}</th>
            </tr>
          </thead>
          <tbody>
            {workspaceSlots.map((row) => (
              <tr>
                <th scope="row">{row.size}</th>
                <td>{row.vcpu} · {row.ram} GiB · {row.disk} GiB</td>
                <td><strong>{row.slot}</strong><span class="pws__per">{ws.per}</span></td>
                <td>+{row.backups}<span class="pws__per">{ws.per}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ul class="pws__notes">
        {ws.notes.map((note) => <li>{note}</li>)}
      </ul>

      <a class="btn btn-ghost pws__cta" href={wsDocs}>{ws.cta}</a>
    </div>
  </div>
</section>

<style>
  .pricing { padding-block: clamp(64px, 9vh, 130px); }
  .pricing__title {
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--color-text);
    font-size: clamp(40px, 5vw, 76px);
    line-height: 1.0;
    letter-spacing: -0.01em;
  }
  .pricing__sub {
    margin-top: var(--space-6);
    max-width: 52ch;
    color: var(--color-text);
    font-size: clamp(16px, 1.15vw, 18px);
    line-height: 1.7;
  }

  .pricing__grid {
    display: grid;
    /* entre 900 y 1100px las 3 columnas dejaban tarjetas de ~280px con 560 de
       alto; auto-fit las baja a 2 y luego a 1 sin escalón intermedio duro.
       min(300px, 100%) es imprescindible: con minmax(300px,...) a secas la
       pista no baja de 300 y desborda 28px en un móvil de 320. */
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-4);
    margin-top: var(--space-12);
    align-items: stretch;
    max-width: 1080px;
    margin-inline: auto;
  }

  .ptier {
    display: flex;
    flex-direction: column;
    min-height: 560px;
    padding: var(--space-8) var(--space-6);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    transition: border-color var(--dur-micro) var(--ease), transform var(--dur-micro) var(--ease);
  }
  .ptier:hover { border-color: var(--color-violet); transform: translateY(-4px); }
  .ptier--ref { background: var(--color-violet-dim); border-color: var(--color-violet); }

  .ptier__top { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .ptier__name { font-family: var(--font-mono); font-size: 14px; color: var(--color-text-dim); }
  .ptier__badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-violet);
    padding: 3px 8px;
    white-space: nowrap;
  }
  .ptier__badge--ghost { visibility: hidden; }

  .ptier__price {
    margin-top: var(--space-6);
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .ptier__amount {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(42px, 4.6vw, 60px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }
  /* per siempre en su propia línea -> bloque de precio de altura igual en los 3 tiers */
  .ptier__per { flex-basis: 100%; font-family: var(--font-mono); font-size: 13px; color: var(--color-text-dim); }

  .ptier__list {
    list-style: none;
    margin: var(--space-8) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1;
  }
  .ptier__list li {
    position: relative;
    padding-left: 24px;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-text);
  }
  .ptier__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-violet);
  }

  /* botón anclado abajo; los 3 CTAs quedan a la misma altura */
  .ptier__cta { width: 100%; margin-top: auto; }
  .ptier__cond {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-muted);
    margin-top: var(--space-4);
    min-height: 3em; /* reserva 2 líneas -> condición de altura igual en los 3 tiers */
  }

  /* Workspace slots: an add-on to the tiers above, so a table, not a fourth card. */
  .pws {
    max-width: 1080px;
    margin: var(--space-16) auto 0;
    padding: var(--space-8) var(--space-6);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .pws__label { font-family: var(--font-mono); font-size: 12px; color: var(--color-text-dim); }
  .pws__title {
    margin-top: var(--space-3);
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--color-text);
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.05;
  }
  .pws__sub {
    margin-top: var(--space-4);
    max-width: 64ch;
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.6;
  }
  /* Only the table scrolls on a narrow phone, never the page. */
  .pws__tablewrap { margin-top: var(--space-8); overflow-x: auto; }
  .pws__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text);
  }
  .pws__table th,
  .pws__table td {
    text-align: left;
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-bottom: 1px solid var(--color-line);
    white-space: nowrap;
  }
  .pws__table thead th { font-weight: 400; color: var(--color-muted); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }
  .pws__table tbody th { font-weight: 600; }
  .pws__table strong { font-weight: 700; }
  .pws__per { color: var(--color-text-dim); margin-left: 2px; }
  .pws__notes {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .pws__notes li {
    position: relative;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text);
  }
  .pws__notes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-violet);
  }
  .pws__cta { margin-top: var(--space-6); }

  @media (max-width: 900px) {
    .pricing { padding-block: var(--space-16); }
  }
  @media (max-width: 640px) {
    .ptier { min-height: 0; }
    .pws { padding: var(--space-6) var(--space-4); }
    .pws__table { font-size: 12px; }
    .pws__table th,
    .pws__table td { padding-right: var(--space-3); }
  }
</style>
