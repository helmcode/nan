---
/*
 * ApiReference: la referencia interactiva de la API en /docs/api, servida con
 * Scalar desde src/data/openapi.json en vez de escrita a mano en MDX.
 *
 * Es una página COMPLETA, no un componente dentro de Docs.astro: Scalar trae su
 * propio layout (sidebar sincronizado, paneles sticky, un grid de 100dvh) y
 * meterlo dentro del layout de docs es pelearse con él. Lo que añadimos es la
 * barra superior de NaN encima, y del resto se encarga Scalar.
 *
 * Los dos idiomas renderizan la MISMA spec: el contenido de una referencia de
 * API se queda en inglés por convención, y lo que se traduce es el chrome y las
 * etiquetas de la UI de Scalar (su opción `locale`). El cambio de idioma usa
 * enlaces normales, como el resto del sitio (Nav.astro), no el hot swap que
 * había en helmcode.
 */
/*
 * Fuentes autoalojadas, como en Docs.astro y NanBase.astro. Sin ellas la página
 * declara `--scalar-font: var(--font-sans)` (Archivo) pero el navegador no
 * tiene de dónde sacarla y cae a la del sistema: correcto en las variables CSS
 * y mal en pantalla. No se pueden dejar a Scalar, que las serviría desde
 * fonts.scalar.com (ver `withDefaultFonts: false` más abajo).
 */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';

import DocsTopBar from './DocsTopBar.astro';
import { type Locale } from '../../lib/i18n';
import '../../styles/docs-shell.css';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;

/* Solo el copy de esta página: el de la barra vive en DocsTopBar.astro. */
const t = {
  en: {
    title: 'API Reference · NaN Docs',
    description:
      'Interactive reference for the NaN API: OpenAI-compatible endpoints for chat, embeddings, rerank, audio, images and web search.',
  },
  es: {
    title: 'Referencia API · NaN Docs',
    description:
      'Referencia interactiva de la API de NaN: endpoints compatibles con OpenAI para chat, embeddings, rerank, audio, imágenes y búsqueda web.',
  },
}[lang];

const SITE = 'https://nan.builders';
const canonical = `${SITE}${Astro.url.pathname.replace(/\/+$/, '') || '/'}`;
const ogImage = `${SITE}/og/og-${lang}.png`;

/*
 * `connect-src` tiene que permitir api.nan.builders o el "try it" no funciona:
 * el navegador manda la petición desde esta página al dominio de la API. Va en
 * directo a propósito, sin el proxy cloud de Scalar (`proxyUrl: ''` más abajo):
 * enviar la clave de un miembro a un tercero contradice el "zero logs" del
 * producto. La API responde con CORS abierto, así que no hace falta
 * intermediario. `worker-src blob:` es para el resaltado de sintaxis de Scalar.
 */
const CSP = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self' data:",
  "img-src 'self' data: https:",
  "connect-src 'self' https://api.nan.builders",
  "worker-src 'self' blob:",
  "frame-src 'none'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={t.description} />
    <meta http-equiv="Content-Security-Policy" content={CSP} />

    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${SITE}/docs/api`} />
    <link rel="alternate" hreflang="es" href={`${SITE}/es/docs/api`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}/docs/api`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NaN" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{t.title}</title>

    <!--
      Scalar se monta en el cliente, así que hay un hueco entre que carga el
      HTML y arranca el JS. Pintar aquí el fondo del sistema evita que ese hueco
      se vea como un flash blanco (los navegadores pintan blanco por defecto).
    -->
    <style>
      html,
      body {
        margin: 0;
        background: #0b0b0c;
      }
    </style>
  </head>
  <body class="docs">
    <DocsTopBar lang={lang} bilingual current="reference" />

    <!-- Scalar se monta aquí. -->
    <div id="scalar-api-reference"></div>

    <style is:global>
      /* Empuja los paneles sticky de Scalar por debajo de nuestra barra. El
         resto del chrome (barra, wordmark, enlaces, idioma) vive en
         src/styles/docs-shell.css, compartido con el layout de las guías. */
      .scalar-app {
        --refs-header-height: var(--doc-top) !important;
      }
    </style>

    <script>
      import { createApiReference } from '@scalar/api-reference';
      // La hoja de estilos de Scalar NO se inyecta sola cuando el paquete se
      // empaqueta con Vite, así que hay que importarla a mano. Sin ella la
      // referencia sale sin estilos: SVGs gigantes y la nav como lista de viñetas.
      import '@scalar/api-reference/style.css';
      import '../../styles/scalar-theme.css';

      const SELECTOR = '#scalar-api-reference';
      const LANG = document.documentElement.lang === 'es' ? 'es' : 'en';

      const CONFIG = {
        url: '/openapi.json',
        pageTitle: 'NaN API',
        locale: LANG,
        // El sitio es solo oscuro; sin forzarlo Scalar sigue al sistema y un
        // visitante en modo claro vería una referencia blanca sobre un sitio negro.
        darkMode: true,
        forceDarkModeState: 'dark' as const,
        // Por defecto Scalar inyecta sus propias fuentes desde fonts.scalar.com.
        // Eso manda la IP de cada visitante a un tercero, que es justo lo que
        // evita autoalojar las fuentes del resto del sitio (ver Docs.astro).
        // Tampoco hacen falta: el tema ya usa Archivo y JetBrains Mono vía
        // --scalar-font / --scalar-font-code.
        withDefaultFonts: false,
        // "Generate MCP" es una función del producto alojado de Scalar: consulta
        // su registro en api.scalar.com en cada carga. Se apaga aquí y no solo
        // ocultando el botón con CSS, porque ocultarlo no detiene la petición.
        // No tiene nada que ver con el endpoint /mcp de NaN, que SÍ está
        // documentado: aquello es una ruta de la spec, esto una integración de Scalar.
        mcp: { disabled: true },
        // "Ask AI" es el asistente alojado de Scalar. Ocultar su botón no
        // basta: el componente se monta igualmente y consulta api.scalar.com en
        // cada carga (AgentScalarChatInterface, el que pide
        // /vector/registry). Apagado.
        agent: { disabled: true },
        // Parámetros de la petición desplegados; respuestas compactas.
        expandAllSchemaProperties: true,
        defaultOpenAllTags: true,
        // Los esquemas reutilizables ya se muestran inline en cada endpoint.
        hideModels: true,
        // Oculta los snippets HTTP autogenerados: la spec trae x-codeSamples
        // curados (cURL + SDK de OpenAI) para cada endpoint.
        hiddenClients: true as const,
        // Sin el proxy cloud de Scalar: el "try it" va directo a api.nan.builders,
        // que responde con CORS abierto. Así la clave del miembro no pasa por
        // un tercero.
        proxyUrl: '',
      };

      let instance: ReturnType<typeof createApiReference> | null = null;

      function mount() {
        if (instance) return;
        if (!document.querySelector(SELECTOR)) return;
        instance = createApiReference(SELECTOR, CONFIG);
      }

      function unmount() {
        instance?.destroy?.();
        const el = document.querySelector(SELECTOR);
        if (el) el.innerHTML = '';
        instance = null;
      }

      mount();
      // Red de seguridad para view transitions: hoy no hay ClientRouter, así
      // que estos listeners nunca se disparan. Si algún día se añade uno, sin
      // esto la referencia solo aparecería tras una recarga manual.
      document.addEventListener('astro:before-swap', unmount);
      document.addEventListener('astro:page-load', mount);
    </script>
  </body>
</html>
