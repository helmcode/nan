---
import { tObj } from '../../lib/i18n';

interface Props {
  registered: number;
  capacity: number;
  reserve: number;
  locale: string;
}

interface CapacityStrings {
  seatsTaken: string;
  seatsRemaining: string;
  lastSeats: string;
  poolTitle: string;
  poolNote: string;
  poolExplain: string;
  poolBarLabel: string;
  closedTitle: string;
  closedNote: string;
}

const { registered, capacity, reserve, locale } = Astro.props;
const cap = tObj<CapacityStrings>('events.capacity', locale);

// Tramos: normal (r < capacity) y pool (capacity <= r < capacity+reserve).
// El caso "completo" (r >= capacity+reserve) lo gestiona la página, no este componente.
const inPool = registered >= capacity;
const mainTaken = Math.min(registered, capacity);
const mainPct = capacity > 0 ? Math.round((mainTaken / capacity) * 100) : 0;
const poolTaken = Math.max(0, registered - capacity);
const poolPct = reserve > 0 ? Math.round((poolTaken / reserve) * 100) : 0;
const remaining = Math.max(0, capacity - registered);
const lowSeats = !inPool && remaining > 0 && remaining <= 5;

const fill = (s: string, vars: Record<string, number>) =>
  Object.entries(vars).reduce((acc, [k, v]) => acc.replaceAll(`{${k}}`, String(v)), s);

const takenLabel = fill(cap.seatsTaken, { n: mainTaken, cap: capacity });
const remainingLabel = lowSeats
  ? fill(cap.lastSeats, { n: remaining })
  : fill(cap.seatsRemaining, { n: remaining });
const poolNote = fill(cap.poolNote, { cap: capacity, taken: poolTaken, res: reserve });
---

<div class="border border-neutral-800 bg-neutral-900/40 p-6 md:p-8">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <span class="font-mono text-base text-white">{takenLabel}</span>
    <span class={`font-mono text-sm ${lowSeats ? 'text-amber-400' : 'text-neutral-500'}`}>
      {!inPool && remainingLabel}
    </span>
  </div>

  {/* Barra principal: las plazas del evento */}
  <div class="mt-4 h-3 w-full overflow-hidden bg-neutral-800">
    <div
      class="h-full bg-violet-500 transition-all"
      style={`width: ${mainPct}%`}
    >
    </div>
  </div>

  {inPool && (
    <div class="mt-6">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <span class="font-mono text-sm text-amber-400">{cap.poolBarLabel}</span>
        <span class="font-mono text-sm text-neutral-500">{poolTaken} / {reserve}</span>
      </div>
      <div class="mt-3 h-3 w-full overflow-hidden bg-neutral-800">
        <div
          class="h-full bg-amber-500 transition-all"
          style={`width: ${poolPct}%`}
        >
        </div>
      </div>

      <div class="mt-6 border border-amber-500/30 bg-amber-500/10 p-5">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-400">
          {cap.poolTitle}
        </p>
        <p class="mt-2 text-base leading-relaxed text-white">{poolNote}</p>
        <p class="mt-2 text-sm leading-relaxed text-neutral-400">{cap.poolExplain}</p>
      </div>
    </div>
  )}
</div>
