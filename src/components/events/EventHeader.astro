---
/**
 * Cabecera común de las pantallas de un evento: enlace atrás, etiqueta del
 * tipo de evento, nombre y navegación entre pantallas (solo las que aplican
 * al formato/fase). El titular usa la Archivo expandida del sistema, pero con
 * un tamaño propio: estas pantallas montan el shell con scale={false} porque
 * la escala de 96px parte las palabras en columnas estrechas.
 */
import { t, withLang } from '../../lib/i18n';
import type { EventInfo } from '../../lib/events';

interface Props {
  event: EventInfo;
  locale: string;
  /** Pantalla actual: se resalta y no se enlaza. */
  current: 'index' | 'me' | 'submission' | 'projects' | 'leaderboard';
  hasSession?: boolean;
}
const { event, locale, current, hasSession = false } = Astro.props;
const base = `/events/${event.slug}`;
const kindLabel = event.kind === 'hackathon'
  ? t('events.kindHackathon', locale)
  : event.kind === 'challenge' ? t('events.kindChallenge', locale) : t('events.kindEvent', locale);

const nav: { key: Props['current']; href: string; label: string }[] = [];
if (hasSession) nav.push({ key: 'me', href: `${base}/me`, label: t('events.nav.me', locale) });
if (hasSession && event.phase !== 'registration') nav.push({ key: 'submission', href: `${base}/submission`, label: t('events.nav.submission', locale) });
if (event.windows.gallery.visible) nav.push({ key: 'projects', href: `${base}/projects`, label: t('events.nav.projects', locale) });
if (event.windows.leaderboard.visible) nav.push({ key: 'leaderboard', href: `${base}/leaderboard`, label: t('events.nav.leaderboard', locale) });
---

<a href={withLang(current === 'index' ? '/events' : base, locale)}
   class="inline-block font-mono text-sm text-neutral-500 transition-colors hover:text-violet-400">
  {current === 'index' ? t('events.backToEvents', locale) : t('events.backToEvent', locale)}
</a>
<header class="mt-10">
  <p class="font-mono text-sm uppercase tracking-[0.2em] text-violet-400">// {kindLabel}</p>
  <h1 class="ev-title mt-4 text-white">{event.name}</h1>
  {nav.length > 0 && (
    <nav class="mt-8 flex flex-wrap gap-x-6 gap-y-2 border-t border-neutral-800 pt-4 font-mono text-sm" aria-label={t('events.nav.aria', locale)}>
      {nav.map((n) => n.key === current
        ? <span class="text-white" aria-current="page">{n.label}</span>
        : <a href={withLang(n.href, locale)} class="text-neutral-400 transition-colors hover:text-violet-400">{n.label}</a>)}
    </nav>
  )}
</header>

<style>
  /* Titular de la casa (Archivo expandida, mayúsculas) a una escala que cabe
     en la columna de la ficha; sin !important para no pelear con .nan-scale. */
  .ev-title {
    font-family: var(--font-serif);
    font-variation-settings: 'wdth' 118, 'wght' 850;
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    overflow-wrap: break-word;
    text-wrap: balance;
  }
</style>
